      "script": "const assert=require('node:assert/strict'), fs=require('node:fs');\nconst {validateConfig}=require('./src/config');\nconst {spokenCaptionFilters}=require('./src/spokenCaptions');\nconst config=JSON.parse(fs.readFileSync('demos/offline-facility-verification.json','utf8'));\nvalidateConfig(config); assert.ok(fs.existsSync(config.transcript.source));\nconst seconds=value=>value.split(':').reduce((sum,part)=>sum*60+Number(part),0);\nconst cues=fs.readFileSync(config.transcript.source,'utf8').split(/\\n\\s*\\n/).filter(block=>block.includes(' --> ')).map(block=>{\n  const [timing,...lines]=block.split('\\n'); const [start,end]=timing.split(' --> ').map(seconds);\n  return {start,end,text:lines.join(' ').trim()};\n});\nspokenCaptionFilters(cues,'/unused-font-path');\nconsole.log(JSON.stringify({configuration:'PASS',captionLayout:'PASS',cues:cues.length,voiceRendered:false}));",
