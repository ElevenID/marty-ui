    "text_rules": [
      {
        "id": "unsigned-oidc-decoder-baseline",
        "glob": "services/auth/**/*.py",
        "pattern": "(?<![A-Za-z0-9_])(?:_?decode_jwt_claims|parse_id_token)(?![A-Za-z0-9_])",
        "expected_matches": {}
      },
      {
        "id": "pkce-is-not-token-validation-baseline",
        "glob": "services/auth/**/*.py",
        "pattern": "already validated via PKCE",
        "expected_matches": {}
      },
      {
        "id": "auth-base64url-decode-baseline",
        "glob": "services/auth/**/*.py",
        "pattern": "urlsafe_b64decode",
        "expected_matches": {
          "services/auth/infrastructure/adapters/http_adapter.py": 1
        }
      },
      {
        "id": "no-direct-auth-native-imports",
        "glob": "services/auth/**/*.py",
        "pattern": "(?:from|import)\\s+(?:marty_rs|_marty_rs)",
        "expected_matches": {}
      },
      {
        "id": "no-python-flow-transition-table",
        "glob": "services/flow/**/*.py",
        "pattern": "\\b(?:VALID_TRANSITIONS|TERMINAL_STATES)\\b",
        "expected_matches": {}
      },
      {
        "id": "no-direct-flow-status-assignment",
        "glob": "services/flow/**/*.py",
        "pattern": "instance\\.status\\s*=(?!=)",
        "expected_matches": {}
      },
      {
        "id": "no-direct-flow-native-imports",
        "glob": "services/flow/**/*.py",
        "pattern": "(?:from|import)\\s+(?:marty_rs|_marty_rs)",
        "expected_matches": {}
      },
      {
        "id": "no-python-did-resolution-kernel",
        "glob": "services/common/did_resolution.py",
        "pattern": "(?:import\\s+(?:base64|httpx|ipaddress|socket)|getaddrinfo|_resolve_did_jwk|_validate_document|AsyncClient)",
        "expected_matches": {}
      },
      {
        "id": "no-direct-did-native-imports",
        "glob": "services/common/did_resolution.py",
        "pattern": "(?:from|import)\\s+(?:marty_rs|_marty_rs)",
        "expected_matches": {}
      },
      {
        "id": "no-python-did-identifier-kernel",
        "glob": "services/flow/**/*.py",
        "pattern": "(?:def\\s+_(?:base58_encode|ec_public_key_from_jwk)\\s*\\(|EllipticCurvePublicNumbers|multicodec_bytes)",
        "expected_matches": {}
      },
      {
