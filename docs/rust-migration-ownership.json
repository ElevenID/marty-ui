    "text_rules": [
      {
        "id": "unsigned-oidc-decoder-baseline",
        "glob": "services/auth/**/*.py",
        "pattern": "(?<![A-Za-z0-9_])(?:_?decode_jwt_claims|parse_id_token)(?![A-Za-z0-9_])",
        "expected_matches": {}
      },
      {
        "id": "pkce-is-not-token-validation-baseline",
        "glob": "services/auth/**/*.py",
        "pattern": "already validated via PKCE",
        "expected_matches": {}
      },
      {
        "id": "auth-base64url-decode-baseline",
        "glob": "services/auth/**/*.py",
        "pattern": "urlsafe_b64decode",
        "expected_matches": {
          "services/auth/infrastructure/adapters/http_adapter.py": 1
        }
      },
      {
        "id": "no-direct-auth-native-imports",
        "glob": "services/auth/**/*.py",
        "pattern": "(?:from|import)\\s+(?:marty_rs|_marty_rs)",
        "expected_matches": {}
      },
      {
        "id": "no-disabled-signature-verification",
        "glob": "services/**/*.py",
        "pattern": "verify_signature[\\\"']?\\s*[:=]\\s*False",
        "expected_matches": {}
      },
      {
        "id": "no-python-presentation-policy-evaluator",
        "glob": "services/presentation_policy/*.py",
        "pattern": "(?:_evaluate_constraint|_detected_format_to_canonical|_required_format_to_canonical|_credential_format_satisfies_requirement)",
        "expected_matches": {}
      },
      {
        "id": "no-direct-presentation-policy-native-imports",
        "glob": "services/presentation_policy/*.py",
        "pattern": "(?:from|import)\\s+(?:marty_rs|_marty_rs)",
        "expected_matches": {}
      }
    ]
