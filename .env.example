# Demo OpenWallet SDK Environment Configuration
# Copy this file to .env and customize values for your environment

# =============================================================================
# Keycloak Admin Configuration
# =============================================================================
# Admin console credentials (for Keycloak management)
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=11id

# Both base and beta Compose require the attested remote-key Keycloak image.
# Provide public certificates and distinct scoped OpenBao tokens; no private keys.
KEYCLOAK_KMS_IMAGE_DIGEST=
KEYCLOAK_KMS_ADDR=
KEYCLOAK_KMS_KEY_VERSION=
KEYCLOAK_SIGNING_KMS_TOKEN_FILE=
KEYCLOAK_MASTER_RS256_CERT_FILE=
KEYCLOAK_11ID_RS256_CERT_FILE=
KEYCLOAK_MASTER_COOKIE_TOKEN_FILE=
KEYCLOAK_MASTER_CIBA_TOKEN_FILE=
KEYCLOAK_11ID_COOKIE_TOKEN_FILE=
KEYCLOAK_11ID_CIBA_TOKEN_FILE=

# =============================================================================
# Google OAuth2 (Social Login)
# =============================================================================
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI: https://<PUBLIC_DOMAIN>/realms/11id/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Keycloak Service Account
# =============================================================================
# Secret for the marty-api confidential client (used for token exchange)
MARTY_API_CLIENT_SECRET=marty-api-secret-change-in-production

# =============================================================================
# Credential Login (OID4VP)
# =============================================================================
# UUID of the OpenBadgeLogin presentation policy.
# Available policies (seeded by migrations):
#   50000000-...-000000000001  ElevenID org — SD-JWT MemberCredential
#   50000000-...-000000000002  Marty org   — SD-JWT Member Login Credential
#   50000000-...-000000000003  Marty org   — mDoc Membership ID
#   50000000-...-000000000004  Marty org   — Open Badge Verified Member Badge
CREDENTIAL_LOGIN_POLICY_ID=50000000-0000-0000-0000-000000000004
CREDENTIAL_LOGIN_TRUST_PROFILE_ID=60000000-0000-0000-0000-000000000001
# Internal URL the flow service uses to call back after VP verification
AUTH_SERVICE_INTERNAL_URL=http://auth:8001

# Keycloak database password
KEYCLOAK_DB_PASSWORD=keycloak

# KMS-backed native Issuance gRPC server and local Envoy mTLS bridge.
# Provision distinct non-exportable Transit keys, scoped tokens, public leaf
# certificates and a shared public workload CA before starting this graph.
MARTY_WORKLOAD_IDENTITY_CA_CERT_FILE=
ISSUANCE_WORKLOAD_SERVER_CERT_FILE=
ISSUANCE_TLS_KMS_ADDR=
ISSUANCE_TLS_KMS_TOKEN_FILE=
ISSUANCE_TLS_KMS_KEY_NAME=
ISSUANCE_TLS_KMS_KEY_VERSION=
ENVOY_ISSUANCE_CLIENT_CERT_FILE=
ENVOY_ISSUANCE_TLS_KMS_ADDR=
ENVOY_ISSUANCE_TLS_KMS_TOKEN_FILE=
ENVOY_ISSUANCE_TLS_KMS_KEY_NAME=
ENVOY_ISSUANCE_TLS_KMS_KEY_VERSION=
FLOW_WORKLOAD_CLIENT_CERT_FILE=
FLOW_CLIENT_TLS_KMS_ADDR=
FLOW_CLIENT_TLS_KMS_TOKEN_FILE=
FLOW_CLIENT_TLS_KMS_KEY_NAME=
FLOW_CLIENT_TLS_KMS_KEY_VERSION=

# =============================================================================
# OIDC Client Configuration
# =============================================================================
OIDC_CLIENT_ID=marty-ui

# =============================================================================
# Demo Administrator User
# =============================================================================
DEMO_ADMIN_EMAIL=admin@marty.demo
DEMO_ADMIN_FIRST_NAME=Admin
DEMO_ADMIN_LAST_NAME=User
DEMO_ADMIN_PASSWORD=Admin123!

# Dedicated reviewer used by deterministic lifecycle tests.
DEMO_REVIEWER_EMAIL=reviewer@marty.demo
DEMO_REVIEWER_FIRST_NAME=Review
DEMO_REVIEWER_LAST_NAME=User
DEMO_REVIEWER_PASSWORD=Reviewer123!


# =============================================================================
# Demo Applicant Users
# =============================================================================
# Shared password for all demo applicants
DEMO_APPLICANT_PASSWORD=Applicant123!

# Applicant 1
DEMO_APPLICANT1_EMAIL=john.doe@marty.demo
DEMO_APPLICANT1_FIRST_NAME=John
DEMO_APPLICANT1_LAST_NAME=Doe
DEMO_APPLICANT1_NATIONALITY=USA
DEMO_APPLICANT1_DOB=1985-03-15

# Applicant 2
DEMO_APPLICANT2_EMAIL=jane.smith@marty.demo
DEMO_APPLICANT2_FIRST_NAME=Jane
DEMO_APPLICANT2_LAST_NAME=Smith
DEMO_APPLICANT2_NATIONALITY=GBR
DEMO_APPLICANT2_DOB=1990-07-22

# Applicant 3
DEMO_APPLICANT3_EMAIL=carlos.garcia@marty.demo
DEMO_APPLICANT3_FIRST_NAME=Carlos
DEMO_APPLICANT3_LAST_NAME=Garcia
DEMO_APPLICANT3_NATIONALITY=ESP
DEMO_APPLICANT3_DOB=1978-11-08

# =============================================================================
# Database Configuration
# =============================================================================
# Applicant service database
APPLICANT_DB_PASSWORD=marty

# =============================================================================
# Session & Security
# =============================================================================
# Session cookie max age in seconds (default: 30 minutes)
SESSION_MAX_AGE=1800

# Environment: development or production
# Production enables strict cookie security (Secure, SameSite=Strict, __Host- prefix)
ENVIRONMENT=development

# =============================================================================
# Frontend Environment Variables (Vite)
# =============================================================================
# API URL for backend services (used by UI proxy configuration)
# This variable is exposed to the browser via Vite
VITE_API_URL=http://127.0.0.1:8000
VITE_KEYCLOAK_REALM=11id

# =============================================================================
# Unified Tunnel + External Access (single .env source)
# =============================================================================
# Cloudflare token (required for tunnel-start)
CLOUDFLARE_TUNNEL_TOKEN=

# Public domain and URLs
PUBLIC_DOMAIN=beta.elevenidllc.com
PUBLIC_URL=https://beta.elevenidllc.com
PUBLIC_API_URL=https://beta.elevenidllc.com
UI_BASE_URL=https://beta.elevenidllc.com

# Tunnel nginx routes to local UI server port
# - 3000: vite dev
# - 3002: vite preview (production build)
UI_DEV_PORT=3002

# Auth/OIDC URLs
OIDC_CLIENT_ID=marty-ui
OIDC_ISSUER_URL_INTERNAL=http://keycloak:8080/realms/11id

# Native passkeys on qualified Keycloak 26.8.x: empty preserves existing policy.
# Enable only with a stable public RP hostname; see docs/keycloak-passkeys.md.
KEYCLOAK_PASSKEYS_ENABLED=
KEYCLOAK_PASSKEY_RP_ID=
OIDC_ISSUER_URL_EXTERNAL=http://localhost:8180/realms/11id
OIDC_ACCESS_TOKEN_AUDIENCE=marty-ui
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_REDIRECT_URI=https://beta.elevenidllc.com/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://beta.elevenidllc.com/

# Cookie and CORS settings
COOKIE_SECURE=true
COOKIE_SAMESITE=none
CORS_ORIGINS=https://beta.elevenidllc.com,http://localhost:9080,http://localhost:3000,http://localhost:5173
SESSION_COOKIE_DOMAIN=.elevenidllc.com
SESSION_SECRET=dev-session-secret-change-in-production

# Optional: Additional service URLs (if using separate microservices)
# VITE_ISSUER_API=http://localhost:8080
# VITE_VERIFIER_API=http://localhost:8081
# VITE_WALLET_API=http://localhost:8082

# =============================================================================
# gRPC Configuration
# =============================================================================
# Shared bearer token for intra-service gRPC authentication. Production
# deployments should use GRPC_SERVICE_TOKEN_FILE (Docker/Kubernetes secret).
GRPC_SERVICE_TOKEN=change_me_with_at_least_32_random_characters
DEVICE_REGISTRATION_GATEWAY_KEY=change_me_with_a_distinct_32_plus_random_characters
DEVICE_REGISTRATION_SIGNING_KEYS_KEY=change_me_with_another_distinct_32_plus_random_characters
# Dedicated beta-only operator token for private passport submission reconciliation.
# Set a distinct random value of at least 32 characters before selecting the native beta profile.
PASSPORT_BETA_RECONCILIATION_OPERATOR_TOKEN=replace_me_with_a_distinct_32_plus_random_token
# GRPC_SERVICE_TOKEN_FILE=/run/secrets/grpc_service_token
# Public TLS certificate and remote signer for the Notification gRPC listener.
# GRPC_TLS_CERT=/etc/certs/server.crt
# GRPC_TLS_KMS_ADDR=https://openbao:8200
# GRPC_TLS_KMS_CA_CERT=/etc/certs/openbao-ca.crt
# GRPC_TLS_KMS_TOKEN_FILE=/run/secrets/notification_tls_signer_token
# GRPC_TLS_KMS_KEY_NAME=notification-server
# GRPC_TLS_KMS_KEY_VERSION=1
# Public CA for gRPC client authentication; separate from OpenBao's CA.
# GRPC_TLS_CA_CERT=/etc/certs/workload-client-ca.crt
GRPC_INSECURE_ALLOWED=true

# =============================================================================
# Flow / Verifier Service
# =============================================================================
# Public verifier DID. The organization registry resolves this to the active
# OID4VP request-signing profile; no profile or KMS key selector is public.
# OID4VP_ISSUER_DID=did:web:example.com:orgs:marty
VERIFIER_CLIENT_ID=marty-verifier
NONCE_TTL_SECONDS=300
REDIS_DB_FLOW=1
FLOW_WEBHOOK_SECRET=change_me_flow_webhook_secret
# Dedicated Applicant -> Flow approval-event identity. Use the same random
# value in Applicant and Flow only; do not reuse GRPC_SERVICE_TOKEN.
FLOW_APPLICATION_EVENT_HMAC_KEY=change_me_with_a_distinct_32_byte_random_key
# FLOW_APPLICATION_EVENT_HMAC_KEY_FILE=/run/secrets/flow_application_event_hmac_key

# =============================================================================
# Notification Service
# =============================================================================
NOTIFICATION_WEBHOOK_SECRET=change_me_notification_webhook_secret
# Production deployments should use NOTIFICATION_WEBHOOK_SECRET_FILE.
# NOTIFICATION_WEBHOOK_SECRET_FILE=/run/secrets/notification_webhook_secret
DIRECT_WEBHOOK_MAX_RETRIES=3
WEBHOOK_CIRCUIT_BREAKER_THRESHOLD=5
NOTIFICATION_WEBHOOK_OUTBOX_RETENTION_SECONDS=86400
NOTIFICATION_WEBHOOK_OUTBOX_LEASE_SECONDS=30
NOTIFICATION_WEBHOOK_OUTBOX_POLL_MILLISECONDS=1000
NOTIFICATION_WEBHOOK_OUTBOX_BATCH_SIZE=25
# NOTIFICATION_EVENT_INGEST_URL=http://notification:8007/internal/events
NOTIFICATION_EVENT_PRODUCER_ID=applicant
NOTIFICATION_APPLICANT_EVENT_TOKEN=change_me_notification_applicant_event_token
# Production deployments should use NOTIFICATION_APPLICANT_EVENT_TOKEN_FILE.
# NOTIFICATION_APPLICANT_EVENT_TOKEN_FILE=/run/secrets/notification_applicant_event_token

# =============================================================================
# Gateway Service
# =============================================================================
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20

# =============================================================================
# VCDM Related Resources
# =============================================================================
# Optional comma-separated exact HTTPS URLs accepted in credential
# relatedResource entries. Empty is fail-closed. The issuance service still
# fetches each configured URL and verifies its declared digest.
VCDM_RELATED_RESOURCE_URLS=

# =============================================================================
# =============================================================================
# Optional LTI Deep Linking `iss`; falls back to the bound platform client ID.
# Dedicated RS256 issuer DID. The resolver owns the profile-to-KMS binding.
# credential issuer/document signer profile IDs.
# DID verification method: <issuer DID>#<fragment>
# Public RSA keys only. Retiring keys may include `retired_at`; never put d/p/q or other private fields here.
# Compatibility-only custom webhook/AGS/NRPS event ingestion; keep false for portable v1.
# server-derived from these origins; do not put token/JWKS URLs in this value.
# A readiness snapshot includes live KMS/DID verification and must be refreshed before this age.
# Standalone PostgreSQL-backed synchronization worker. The processor must use module:function syntax.
# A five-second cycle keeps the database heartbeat inside the 120-second readiness window.
# Local sandbox URL relaxations. Keep false outside isolated dev/test stacks.

# Cedar authorization policy paths
# CEDAR_SCHEMA_PATH=./policies/schema.cedarschema
# CEDAR_POLICIES_DIR=./policies/

# =============================================================================
# Auth Service (Extended)
# =============================================================================
AUTH_RATE_LIMIT_RPM=30
COOKIE_SAMESITE=Lax
# OIDC_CLIENT_SECRET=  # Confidential client secret (if not using public client)

# =============================================================================
# Device Registration
# =============================================================================
DEVICE_CHALLENGE_TTL=300
# Server-owned grace for exact challenges issued before a device-key rotation.
# Values above 900 seconds fail startup/rotation rather than extending old-key authority.
DEVICE_KEY_ROTATION_GRACE_SECONDS=300

# =============================================================================
# Observability
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# =============================================================================
# Organization Identity
# =============================================================================
MARTY_ORG_ID=00000000-0000-0000-0000-000000000001
MARTY_ORG_ADMIN_EMAIL=admin@marty.demo
MARTY_ORG_REVIEWER_EMAIL=reviewer@marty.demo
# Physical ICAO document issuance (required only when enabling that capability)
# Keep both native selectors off until the full passport cutover gate passes.
# Gateway, Flow, and native issuance must receive the same organization-to-key JSON.
PASSPORT_NATIVE_HTTP_ENABLED=false
PASSPORT_KMS_CALLBACKS_ENABLED=false
PASSPORT_NATIVE_FLOW_ENABLED=false
PASSPORT_NATIVE_GATEWAY_ENABLED=false
PASSPORT_TENANT_API_KEYS=
# Prefer a mounted secret file over an inline keyring in deployed environments.
# PASSPORT_TENANT_API_KEYS_FILE=/run/secrets/passport_tenant_api_keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KMS-only artifact storage is opt-in; drain legacy Fernet jobs before switching.
PASSPORT_KMS_ARTIFACTS_ENABLED=false
PERSONALIZATION_BUREAU_URL=
PERSONALIZATION_BUREAU_API_KEY=
PERSONALIZATION_BUREAU_PROVIDER_PROFILE_ID=
# Verification DID resolution is organization/internal first. Public did:web
# fallback must be explicitly enabled and exact-host allowlisted.
DID_PUBLIC_FALLBACK_ENABLED=false
DID_WEB_ALLOWED_HOSTS=
