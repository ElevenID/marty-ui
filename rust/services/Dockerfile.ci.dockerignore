# CI image inputs only. Other Dockerfiles retain the root ignore policy.
**
!rust/
!rust/**
!proto/
!proto/**
!contracts/
!contracts/**
contracts/canvas-worker-oracle-producers.json
contracts/canvas-worker-oracle-script-imports.json
contracts/canvas-worker-startup-current-inputs.json
contracts/canvas-worker-rest-current-inputs.json
