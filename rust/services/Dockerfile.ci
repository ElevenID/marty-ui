FROM runtime AS applicant
ARG MARTY_RELEASE_VERSION=development
ARG MARTY_UI_SHA=unknown
LABEL org.opencontainers.image.source="https://github.com/ElevenID/marty-ui" \
      org.opencontainers.image.revision="${MARTY_UI_SHA}" \
      org.opencontainers.image.version="${MARTY_RELEASE_VERSION}"
COPY --from=builder /build/rust/target/release/marty-applicant /usr/local/bin/marty-applicant
COPY --chown=10001:10001 scripts/load-secrets-env.sh /usr/local/bin/load-secrets-env.sh
USER root
RUN install -d -o marty -g marty -m 0700 /app/data
USER 10001:10001
ENV APPLICANT_SERVICE_PORT=8006 \
    APPLICANT_DATA_FILE=/app/data/applicant_store.json \
    MARTY_RELEASE_VERSION=${MARTY_RELEASE_VERSION} \
    MARTY_UI_SHA=${MARTY_UI_SHA} \
    RUST_LOG=info
EXPOSE 8006
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD ["curl", "--fail", "http://127.0.0.1:8006/health"]
ENTRYPOINT ["/bin/sh", "-c", ". /usr/local/bin/load-secrets-env.sh && exec /usr/local/bin/marty-applicant"]

