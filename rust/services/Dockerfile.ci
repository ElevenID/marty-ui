# syntax=docker/dockerfile:1.7
# CI-only multi-target image build. Cargo Chef keeps the dependency layer
# reusable when application source changes, while both binaries are still
# compiled together in one shared production-equivalent layer.
FROM rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS chef

RUN apt-get update \
    && apt-get install -y --no-install-recommends mold \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"

RUN --mount=type=cache,id=marty-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=marty-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo install cargo-chef --locked --version 0.1.78

WORKDIR /build/rust

FROM chef AS planner

COPY rust /build/rust
COPY proto /build/proto
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /build/rust/recipe.json recipe.json
COPY proto /build/proto
RUN --mount=type=cache,id=marty-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=marty-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --locked --release --workspace --recipe-path recipe.json

COPY rust /build/rust
COPY proto /build/proto
RUN --mount=type=cache,id=marty-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=marty-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo build --locked --release \
    -p marty-event-stream --bin marty-event-stream \
    -p marty-gateway --bin marty-gateway \
    -p marty-revocation-profile --bin marty-revocation-profile \
    -p marty-notification --bin marty-notification \
    -p marty-signing-keys --bin marty-signing-keys \
    -p marty-flow --bin marty-flow \
    -p marty-organization --bin marty-organization \
    -p marty-credential-template --bin marty-credential-template \
    -p marty-presentation-policy --bin marty-presentation-policy \
    -p marty-trust-profile --bin marty-trust-profile \
    -p marty-applicant --bin marty-applicant \
    -p marty-device-registration --bin marty-device-registration \
    -p marty-verification-service --bin marty-verification-service

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin marty

USER 10001:10001

FROM runtime AS event_stream
ARG MARTY_RELEASE_VERSION=development
ARG MARTY_UI_SHA=unknown
LABEL org.opencontainers.image.source="https://github.com/ElevenID/marty-ui" \
      org.opencontainers.image.revision="${MARTY_UI_SHA}" \
      org.opencontainers.image.version="${MARTY_RELEASE_VERSION}"
COPY --from=builder /build/rust/target/release/marty-event-stream /usr/local/bin/marty-event-stream
ENV EVENT_STREAM_SERVICE_PORT=8015 \
    EVENT_STREAM_GRPC_ENABLED=true \
    EVENT_STREAM_GRPC_PORT=9015 \
    RUST_LOG=info
EXPOSE 8015 9015
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=5 \
    CMD ["curl", "--fail", "http://127.0.0.1:8015/health"]
ENTRYPOINT ["/usr/local/bin/marty-event-stream"]

FROM runtime AS gateway
ARG MARTY_RELEASE_VERSION=development
ARG MARTY_UI_SHA=unknown
LABEL org.opencontainers.image.source="https://github.com/ElevenID/marty-ui" \
      org.opencontainers.image.revision="${MARTY_UI_SHA}" \
      org.opencontainers.image.version="${MARTY_RELEASE_VERSION}"
COPY --from=builder /build/rust/target/release/marty-gateway /usr/local/bin/marty-gateway
ENV GATEWAY_PORT=8000 \
    MARTY_RELEASE_VERSION=${MARTY_RELEASE_VERSION} \
    MARTY_UI_SHA=${MARTY_UI_SHA} \
    RUST_LOG=info
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=3s --retries=5 \
    CMD ["curl", "--fail", "http://127.0.0.1:8000/health"]
ENTRYPOINT ["/usr/local/bin/marty-gateway"]

FROM runtime AS revocation_profile
ARG MARTY_RELEASE_VERSION=development
ARG MARTY_UI_SHA=unknown
LABEL org.opencontainers.image.source="https://github.com/ElevenID/marty-ui" \
      org.opencontainers.image.revision="${MARTY_UI_SHA}" \
      org.opencontainers.image.version="${MARTY_RELEASE_VERSION}"
COPY --from=builder /build/rust/target/release/marty-revocation-profile /usr/local/bin/marty-revocation-profile
COPY --chown=10001:10001 scripts/load-secrets-env.sh /usr/local/bin/load-secrets-env.sh
ENV REVOCATION_PROFILE_SERVICE_PORT=8013 \
    RP_GRPC_ENABLED=true \
    RP_GRPC_PORT=9013 \
    MARTY_RELEASE_VERSION=${MARTY_RELEASE_VERSION} \
    MARTY_UI_SHA=${MARTY_UI_SHA} \
    RUST_LOG=info
EXPOSE 8013 9013
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=5 \
    CMD ["curl", "--fail", "http://127.0.0.1:8013/health"]
ENTRYPOINT ["/bin/sh", "-c", ". /usr/local/bin/load-secrets-env.sh && exec /usr/local/bin/marty-revocation-profile"]

