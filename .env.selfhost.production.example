# Copy to .env.selfhost.production.local.
# Put real secrets in SELFHOST_SECRET_DIR instead of this env file.

SELFHOST_SECRET_DIR=/path/to/selfhost-secrets
SELFHOST_STATE_DIR=/path/to/selfhost-state
SELFHOST_BACKUP_DIR=../marty-selfhost-prod/backups
SELFHOST_OPENBAO_STATE_DIR=../marty-selfhost-prod/openbao/state
SELFHOST_OPENBAO_EXPORT_DIR=../marty-selfhost-prod/openbao/exports
SELFHOST_OPENBAO_HOST_PORT=18200
SELFHOST_IMAGE_PREFIX=ghcr.io/elevenid/marty-ui
# Use an immutable release tag in production, for example 2026.05.0.
SELFHOST_IMAGE_TAG=REPLACE_WITH_RELEASE_TAG
# OpenBao plus the reviewed DIDComm secrets engine, published by immutable digest.
MARTY_OPENBAO_DIDCOMM_IMAGE=REPLACE_WITH_OPENBAO_DIDCOMM_IMAGE_DIGEST
# Use the exact signed Keycloak remote-key OCI URI@sha256 digest from this release.
MARTY_KEYCLOAK_KMS_IMAGE=REPLACE_WITH_KEYCLOAK_KMS_IMAGE_DIGEST
# Required: use the exact issuance OCI URI@sha256 digest from the matching
# qualified stack release manifest. A mutable tag is not a substitute.
MARTY_ISSUANCE_IMAGE=

PUBLIC_DOMAIN=prod.example.com
PUBLIC_API_URL=https://prod.example.com
UI_BASE_URL=https://prod.example.com
# Optional: set only for a secondary hostname intentionally served by this same stack.
# Do not put a separate beta/staging stack hostname here; it will use this Keycloak issuer.
UI_ADDITIONAL_BASE_URLS=
BAO_ADDR=https://host.docker.internal:18200
KEYCLOAK_KMS_ADDR=https://host.docker.internal:18200
KEYCLOAK_KMS_KEY_VERSION=1
SIGNING_KEYS_TLS_KMS_ADDR=https://openbao.example.com:8200
SIGNING_KEYS_TLS_KMS_KEY_NAME=workload-tls-signing-keys-server
SIGNING_KEYS_TLS_KMS_KEY_VERSION=1
ORG_TLS_KMS_ADDR=https://openbao.example.com:8200
ORG_TLS_KMS_KEY_NAME=workload-tls-organization-server
ORG_TLS_KMS_KEY_VERSION=1
ES_TLS_KMS_ADDR=https://openbao.example.com:8200
ES_TLS_KMS_KEY_NAME=workload-tls-event-stream-server
ES_TLS_KMS_KEY_VERSION=1
NOTIFICATION_TLS_KMS_ADDR=https://openbao.example.com:8200
NOTIFICATION_TLS_KMS_KEY_NAME=workload-tls-notification-server
NOTIFICATION_TLS_KMS_KEY_VERSION=1
RP_TLS_KMS_ADDR=https://openbao.example.com:8200
RP_TLS_KMS_KEY_NAME=workload-tls-revocation-profile-server
RP_TLS_KMS_KEY_VERSION=1
CT_TLS_KMS_ADDR=https://openbao.example.com:8200
CT_TLS_KMS_KEY_NAME=workload-tls-credential-template-server
CT_TLS_KMS_KEY_VERSION=1
PP_TLS_KMS_ADDR=https://openbao.example.com:8200
PP_TLS_KMS_KEY_NAME=workload-tls-presentation-policy-server
PP_TLS_KMS_KEY_VERSION=1
AUTH_TLS_KMS_ADDR=https://openbao.example.com:8200
AUTH_TLS_KMS_KEY_NAME=workload-tls-auth-client
AUTH_TLS_KMS_KEY_VERSION=1
AUTH_SERVER_TLS_KMS_ADDR=https://openbao.example.com:8200
AUTH_SERVER_TLS_KMS_KEY_NAME=workload-tls-auth-server
AUTH_SERVER_TLS_KMS_KEY_VERSION=1
GATEWAY_TLS_KMS_ADDR=https://openbao.example.com:8200
GATEWAY_TLS_KMS_KEY_NAME=workload-tls-gateway-auth-client
GATEWAY_TLS_KMS_KEY_VERSION=1
ISSUANCE_TLS_KMS_ADDR=https://openbao.example.com:8200
ISSUANCE_TLS_KMS_KEY_NAME=workload-tls-issuance-server
ISSUANCE_TLS_KMS_KEY_VERSION=1
VERIFICATION_TLS_KMS_ADDR=https://openbao.example.com:8200
VERIFICATION_TLS_KMS_KEY_NAME=workload-tls-verification-client
VERIFICATION_TLS_KMS_KEY_VERSION=1
FLOW_CLIENT_TLS_KMS_ADDR=https://openbao.example.com:8200
FLOW_CLIENT_TLS_KMS_KEY_NAME=workload-tls-flow-client
FLOW_CLIENT_TLS_KMS_KEY_VERSION=1
FLOW_SERVER_TLS_KMS_ADDR=https://openbao.example.com:8200
FLOW_SERVER_TLS_KMS_KEY_NAME=workload-tls-flow-server
FLOW_SERVER_TLS_KMS_KEY_VERSION=1
DEPLOYMENT_PROFILE_TLS_KMS_ADDR=https://openbao.example.com:8200
DEPLOYMENT_PROFILE_TLS_KMS_KEY_NAME=workload-tls-deployment-profile-client
DEPLOYMENT_PROFILE_TLS_KMS_KEY_VERSION=1
COMPLIANCE_PROFILE_TLS_KMS_ADDR=https://openbao.example.com:8200
COMPLIANCE_PROFILE_TLS_KMS_KEY_NAME=workload-tls-compliance-profile-client
COMPLIANCE_PROFILE_TLS_KMS_KEY_VERSION=1
GRPC_INSECURE_ALLOWED=true
KEYCLOAK_REALM=11id
OIDC_ISSUER_URL_EXTERNAL=https://prod.example.com/realms/11id
OIDC_REDIRECT_URI=https://prod.example.com/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://prod.example.com/
CORS_ORIGINS=https://prod.example.com

MARTY_MIGRATION_PROFILE=selfhost-production
MARTY_ORG_ID=00000000-0000-0000-0000-000000000001
MARTY_ORG_DOMAIN=prod.example.com
MARTY_ORG_ADMIN_EMAIL=
# Required for deployed Flow. Keep this organization ID aligned with
# MARTY_ORG_ID. The Auth callback uses HTTP only inside the Compose network;
# externally reachable callback destinations must use HTTPS.
FLOW_CALLBACK_DESTINATIONS=00000000-0000-0000-0000-000000000001|http://auth:8001/internal/v1/auth/credential-verified?nonce=__MARTY_TOKEN__
ORGANIZATION_CREATION_ENABLED=false
KEYCLOAK_REMOVE_DEMO_USERS=true
KEYCLOAK_ADMIN=admin
KEYCLOAK_REPLACE_UI_ORIGINS=true
KEYCLOAK_USER_REGISTRATION_ENABLED=true
KEYCLOAK_VERIFY_EMAIL=true
KEYCLOAK_RESET_PASSWORD_ENABLED=true
KEYCLOAK_SOCIAL_LOGIN_ENABLED=false
KEYCLOAK_ORGANIZATION_IDENTITY_FIRST_ENABLED=false
CREDENTIAL_LOGIN_POLICY_ID=50000000-0000-0000-0000-000000000004
KEYCLOAK_SMTP_HOST=smtp.example.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=noreply@prod.example.com
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Marty Trust Services
KEYCLOAK_SMTP_USERNAME=
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=true
CREDENTIAL_LOGIN_REQUIRE_EXISTING_KEYCLOAK_USER=true
CREDENTIAL_LOGIN_CREATE_USERS=false
# Google login, GA4, and Search Console values now live in SELFHOST_SECRET_DIR:
# - google_client_id
# - google_client_secret
# - google_analytics_measurement_id
# - google_site_verification
SMTP_USERNAME=

SELFHOST_EDGE_HOST_PORT=19080
SELFHOST_GATEWAY_HOST_PORT=18000
SELFHOST_KEYCLOAK_HOST_PORT=18180

RATE_LIMIT_RPM=300
COOKIE_SAMESITE=lax
UNIVERSAL_RESOLVER_URL=
DIDCOMM_ALLOW_PRIVATE_ENDPOINTS=false

# Canvas Credentials institutional mirror.
# Keep provider=bridge for sandbox receivers. Set provider=badgr_api to publish to the real Canvas Credentials API.
CANVAS_CREDENTIALS_PROVIDER=bridge
CANVAS_CREDENTIALS_API_BASE_URL=https://api.badgr.io
CANVAS_CREDENTIALS_ISSUER_ID=
CANVAS_CREDENTIALS_BADGECLASS_ID=
CANVAS_CREDENTIALS_ASSERTION_SCOPE=badgeclasses
CANVAS_CREDENTIALS_PROVENANCE_BASE_URL=https://prod.example.com
CANVAS_CREDENTIALS_RECIPIENT_HASHED=true
CANVAS_CREDENTIALS_ALLOW_DUPLICATE_AWARDS=false
# Public DID network fallback remains disabled unless every approved did:web
# hostname is explicitly listed.
DID_PUBLIC_FALLBACK_ENABLED=false
DID_WEB_ALLOWED_HOSTS=
