# NOTE: This file applies when building from marty-ui/ as the build context.
# For the microservices (docker-compose.base.yml), the build context is the
# parent directory (work/), so the effective .dockerignore is work/.dockerignore.
#
# Node modules - will be installed fresh in container
**/node_modules
**/npm-debug.log

# Build outputs
**/build
**/dist
**/.next
**/out
**/target
openbao/didcomm-authcrypt/.build/

# CI inventory manifests are not product compilation or runtime inputs.
contracts/python-value-fast-obligations.json

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.coverage
**/.mypy_cache

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test results
**/test-results
**/playwright-report
**/coverage

# Environment
.env
.env.local
.env.*.local
docker/secrets/

# Documentation
*.md
!README.md

# Logs
*.log

# Self-host pre-built dist (large build artifact)
ui/dist-selfhost/
ui/build/

# Generated local state and recorded test output
.selfhost-state/
tests/demo-recordings/
tests/demo-recordings-report/
tests/artifacts/

# Do not admit local wheel artifacts into service build contexts.
wheels/

# CI/CD and infra (not needed in image)
.github/
k8s/

# These exact issuance leaves are included only by #[cfg(test)] modules.
# Checkout tests keep them; release Docker COPY rust does not need them.
rust/services/issuance/src/initiation_didcomm/tests/initiation_didcomm_renewal_tests.rs
rust/services/issuance/src/passport_http_reconciliation_tests.rs
rust/services/issuance/src/python_format_tests.rs
rust/services/issuance/src/signing_http_projection_tests.rs
rust/services/issuance/src/signing_http_response_tests.rs
rust/services/issuance/src/token_rate_limit_http_tests.rs
rust/acceptance/support/base_runtime_redis.rs
rust/acceptance/support/didcomm_gateway_replay.rs
rust/acceptance/support/didcomm_native_grpc_fixture.rs
rust/acceptance/support/issuance_named_peers.rs
# Cargo auto-discovers these oid4vp-contract test targets only for `cargo test`.
# Production Docker COPY rust does not compile or execute them.
rust/crates/oid4vp-contract/tests/contract_vectors.rs
rust/crates/oid4vp-contract/tests/transport_metadata.rs
# The worker acceptance target and its three #[path] support modules are test-only.
# Root-context release builders copy Rust but compile production binaries only.
# The Flow acceptance target and its seven support modules are test-only.
# Root-context release builders do not compile or run this test executable.
rust/crates/flow-acceptance/tests/flow_published_schema_contract.rs
rust/crates/flow-acceptance/tests/public_demo_signing_live_kms.rs
rust/crates/flow-acceptance/tests/support/public_demo_browser.rs
rust/crates/flow-acceptance/tests/support/public_demo_canonical.rs
rust/crates/flow-acceptance/tests/support/public_demo_gateway.rs
rust/crates/flow-acceptance/tests/support/didcomm_flow_grpc_admission.rs
rust/crates/flow-acceptance/tests/support/flow_admission.rs
rust/crates/flow-acceptance/tests/support/flow_legacy_physical_http.rs
rust/crates/flow-acceptance/tests/support/flow_native_consumer.rs
rust/crates/flow-acceptance/tests/support/flow_public_startup.rs
rust/crates/flow-acceptance/tests/support/flow_public_startup_peers.rs
rust/crates/flow-acceptance/tests/support/flow_rendered_selection.rs
# The self-host acceptance executable and fixture support are also test-only.
rust/crates/selfhost-acceptance/tests/selfhost_public_image_contract.rs
rust/crates/selfhost-acceptance/tests/native_kms_schema_contract.rs
rust/crates/selfhost-acceptance/tests/managed_postgres_contract.rs
rust/crates/selfhost-acceptance/tests/support/managed_postgres.rs
rust/crates/selfhost-acceptance/tests/support/selfhost_packaged_runtime.rs
rust/crates/selfhost-acceptance/tests/support/selfhost_runtime_sidecar.rs
# Cross-service acceptance targets are compiled from the checkout in CI, not
# from the production image context.
rust/crates/service-acceptance/tests/passport_managed_kms_chain.rs
rust/crates/service-acceptance/tests/passport_gateway_postgres.rs
rust/crates/service-acceptance/tests/gateway_signing_acceptance.rs
rust/crates/service-acceptance/tests/holder_remote_live_kms.rs
rust/crates/service-acceptance/tests/support/holder_issuer_authority.rs
rust/crates/service-acceptance/tests/support/holder_native_receipt.rs
rust/crates/service-acceptance/tests/csca_capability_contract.rs
rust/crates/service-acceptance/tests/tls_openbao_keyless.rs
# CSCA test targets run from the checkout, not images.
rust/services/signing-keys/tests/csca_lifecycle_behavior.rs
rust/services/signing-keys/tests/csca_lifecycle_storage_contract.rs

# Exact platform acceptance wrappers; runtime sources remain included.
rust/crates/flow-acceptance/tests/support/base_runtime_redis.rs
rust/crates/flow-acceptance/tests/support/didcomm_gateway_replay.rs
