# NOTE: This file applies when building from marty-ui/ as the build context.
# For the microservices (docker-compose.base.yml), the build context is the
# parent directory (work/), so the effective .dockerignore is work/.dockerignore.
#
# Node modules - will be installed fresh in container
**/node_modules
**/npm-debug.log

# Build outputs
**/build
**/dist
**/.next
**/out
**/target
openbao/didcomm-authcrypt/.build/

# CI inventory manifests are not product compilation or runtime inputs.
contracts/canvas-worker-oracle-producers.json
contracts/canvas-worker-oracle-script-imports.json
# All matching Canvas input records are CI evidence, never image inputs.
contracts/canvas-*-current-inputs.json
contracts/canvas-worker-tier-obligations.json
contracts/canvas-worker-package-migration.json
contracts/python-value-fast-obligations.json
contracts/canvas-renewal-profile-obligations.json

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.coverage
**/.mypy_cache

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test results
**/test-results
**/playwright-report
**/coverage

# Environment
.env
.env.local
.env.*.local
docker/secrets/

# Documentation
*.md
!README.md
!rust/services/issuance/src/canvas_sync_processor_contract.md

# Logs
*.log

# Self-host pre-built dist (large build artifact)
ui/dist-selfhost/
ui/build/

# Generated local state and recorded test output
.selfhost-state/
tests/demo-recordings/
tests/demo-recordings-report/
tests/artifacts/

# Do not admit local wheel artifacts into service build contexts.
wheels/

# CI/CD and infra (not needed in image)
.github/
k8s/

# These exact issuance leaves are included only by #[cfg(test)] modules.
# Checkout tests keep them; release Docker COPY rust does not need them.
rust/services/issuance/src/canvas_operation_http_prepared_tests.rs
rust/services/issuance/src/canvas_sync_provider_http_tests.rs
rust/services/issuance/src/canvas_sync_processor_tests.rs
rust/services/issuance/src/canvas_sync_worker_retry_tests.rs
rust/services/issuance/src/initiation_didcomm/tests/initiation_didcomm_renewal_tests.rs
rust/services/issuance/src/passport_http_reconciliation_tests.rs
rust/services/issuance/src/python_format_tests.rs
rust/services/issuance/src/signing_http_projection_tests.rs
rust/services/issuance/src/signing_http_response_tests.rs
rust/services/issuance/src/token_rate_limit_http_tests.rs
# Cargo auto-discovers these oid4vp-contract test targets only for `cargo test`.
# Production Docker COPY rust does not compile or execute them.
rust/crates/oid4vp-contract/tests/contract_vectors.rs
rust/crates/oid4vp-contract/tests/transport_metadata.rs
# The worker acceptance target and its three #[path] support modules are test-only.
# Root-context release builders copy Rust but compile production binaries only.
rust/crates/canvas-worker-acceptance/tests/canvas_published_worker_contract.rs
rust/crates/canvas-worker-acceptance/tests/support/canvas_rest_requalification.rs
rust/crates/canvas-worker-acceptance/tests/support/canvas_startup_attestation.rs
rust/crates/canvas-worker-acceptance/tests/support/canvas_worker_roster_metadata.rs
# Canvas composition acceptance target and its support tree are checkout-only.
rust/crates/canvas-acceptance/tests/canvas_published_schema_contract.rs
rust/crates/canvas-acceptance/tests/support/base_runtime_canvas.rs
rust/crates/canvas-acceptance/tests/support/base_runtime_container.rs
rust/crates/canvas-acceptance/tests/support/base_runtime_didcomm.rs
