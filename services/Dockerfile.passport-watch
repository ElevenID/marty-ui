# Local disposable passport debugging only. The released services image remains
# the source for every other service in the stack.
FROM rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/rust
ENTRYPOINT ["/bin/bash", "/workspace/scripts/passport-rust-watch.sh"]
