# Only public service build and runtime inputs. Integration tests remain in
# normal CI; they do not need to invalidate the release image's source layer.
**
!rust/
!rust/**
!proto/
!proto/**
!contracts/
!contracts/**
contracts/canvas-worker-oracle-producers.json
contracts/canvas-worker-oracle-script-imports.json
contracts/canvas-worker-startup-current-inputs.json
contracts/canvas-worker-tier-obligations.json
!services/
!services/entrypoint.sh
!services/auth/
!services/auth/assets/
!services/auth/assets/**
!scripts/
!scripts/build-rust-service-binaries.sh
!scripts/load-secrets-env.sh
!scripts/ci/
!scripts/ci/run-public-rust-build.sh
rust/services/*/tests
rust/crates/*/tests
rust/**/target
rust/**/.git
rust/**/*.log
rust/**/.env*
