{
  "schema_version": 1,
  "identity_binding": [
    "organization_id",
    "issuer_did",
    "oid4vp_request_signing",
    "oauth-authz-req+jwt",
    "ES256"
  ],
  "private_key_access": "signing_provider_only",
  "signing_input": "base64url(protected).base64url(payload)",
  "oid4vp_response_mode": "direct_post",
  "oid4vp_query": "dcql_query",
  "siop_response_type": "id_token",
  "siop_scope": "openid",
  "request_content_type": "application/oauth-authz-req+jwt",
  "mip_message_type": "PresentationRequest",
  "url_query": "unsigned_direct_post_dcql",
  "url_query_minimum_limit": 1024,
  "url_query_oversize": "fail_closed",
  "haip_response_mode": "direct_post.jwt",
  "haip_jwe": {"alg": "ECDH-ES", "enc": "A256GCM"},
  "haip_private_key_storage": "tenant_and_flow_bound_envelope_only",
  "identity_change": "fail_closed"
}
