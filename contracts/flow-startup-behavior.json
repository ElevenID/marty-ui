{
  "schema_version": 1,
  "deployed_environments": ["beta", "production"],
  "required_always": ["DATABASE_URL", "REDIS_URL"],
  "required_when_deployed": [
    "PUBLIC_BASE_URL",
    "FLOW_CALLBACK_DESTINATIONS",
    "ORGANIZATION_GRPC_TARGET|ORG_GRPC_TARGET",
    "CT_GRPC_TARGET",
    "PP_GRPC_TARGET",
    "ISSUANCE_GRPC_TARGET",
    "SIGNING_KEYS_INTERNAL_URL",
    "CREDENTIAL_TEMPLATE_SERVICE_URL",
    "TRUST_PROFILE_SERVICE_URL",
    "DEPLOYMENT_PROFILE_SERVICE_URL",
    "ISSUANCE_SERVICE_URL",
    "GRPC_SERVICE_TOKEN",
    "FLOW_WEBHOOK_SECRET",
    "SIGNING_KEYS_INTERNAL_API_KEY",
    "ISSUANCE_API_KEY",
    "GRPC_WORKLOAD_TLS_CLIENT_CERT",
    "GRPC_WORKLOAD_TLS_CLIENT_KEY",
    "GRPC_WORKLOAD_TLS_SERVER_CERT",
    "GRPC_WORKLOAD_TLS_SERVER_KEY",
    "GRPC_WORKLOAD_TLS_CA_CERT",
    "GRPC_INSECURE_ALLOWED|TLS_DEPENDENCY_TARGETS"
  ],
  "secret_file_suffix": "_FILE",
  "listener_port_aliases": ["FLOW_SERVICE_PORT", "FLOW_GRPC_PORT"],
  "database_driver_alias": "postgresql+asyncpg",
  "minimum_secret_bytes": 32,
  "database_schemes": ["postgres", "postgresql"],
  "redis_schemes": ["redis", "rediss"],
  "dependency_schemes": ["http", "https"],
  "workload_transport": "mutual_tls",
  "partial_tls_behavior": "fail_closed",
  "database_connection_bounds": [1, 100],
  "redis_database_bounds": [0, 255],
  "verifier_profiles": {
    "client_id_schemes": ["redirect_uri", "decentralized_identifier", "x509_hash"],
    "did_methods": ["did:web", "did:jwk", "did:key"],
    "issuer_did_sources": ["OID4VP_ISSUER_DID", "MARTY_ISSUER_DID", "public_origin_default"],
    "request_length_bounds": [1024, 1048576],
    "x509_certificate_sources": ["VERIFIER_X509_CERT_PEM", "VERIFIER_X509_CERT_FILE"],
    "dc_api_expected_origins": "configured_origins_or_public_origin",
    "haip_default": false,
    "strict_metadata_default": false
  },
  "fail_closed_cases": [
    "missing_database",
    "missing_redis",
    "deployed_dependency_default",
    "short_secret",
    "credentialed_url",
    "dependency_url_with_path",
    "shared_listener_address",
    "unreadable_secret_file",
    "partial_workload_tls",
    "implicit_deployed_plaintext",
    "insecure_public_origin",
    "empty_callback_registry",
    "malformed_callback_registry",
    "unsupported_client_id_scheme",
    "unsupported_verifier_did_method",
    "missing_x509_certificate",
    "invalid_request_length_bound",
    "insecure_deployed_logo_uri",
    "invalid_dc_api_expected_origin",
    "invalid_oid4vp_issuer_did"
  ]
}
