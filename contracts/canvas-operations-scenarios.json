{
  "schema": "marty.canvas-operations-scenarios/v1",
  "shared_seed": "canvas-issued-review-scenarios.json",
  "seed": [
    "UPDATE issuance_service.canvas_evidence_sync_targets SET enabled=false WHERE id='target-review'",
    "INSERT INTO issuance_service.canvas_evidence_sync_jobs (id,organization_id,target_id,status,attempt_count,max_attempts,available_at,result,created_at,updated_at,last_error_code,last_error_summary) VALUES ('job-dead','org-review','target-review','dead_letter',8,8,now(),'{\"facts_changed\":1,\"no_change\":false,\"provider_payload\":{\"token\":\"synthetic-private\"},\"roster_remaining\":2}',now(),now(),'synthetic_failure','Bearer synthetic-private-token')",
    "INSERT INTO issuance_service.canvas_award_candidates (id,organization_id,platform_id,binding_id,candidate_key,canvas_user_id,lti_subject,state,observed_at,created_at,updated_at) VALUES ('candidate-ops','org-review','platform-review','binding-review','numeric-user:7','7','subject-private','pending_claim',now(),now(),now())"
  ],
  "snapshot_sql": "SELECT jsonb_build_object('jobs',(SELECT jsonb_agg(jsonb_build_object('id',id,'target_id',target_id,'status',status,'attempt_count',attempt_count,'max_attempts',max_attempts) ORDER BY id) FROM issuance_service.canvas_evidence_sync_jobs),'targets',(SELECT jsonb_agg(jsonb_build_object('id',id,'enabled',enabled) ORDER BY id) FROM issuance_service.canvas_evidence_sync_targets),'reviews',(SELECT jsonb_agg(jsonb_build_object('id',id,'status',status,'action',resolution_action,'actor',resolved_by,'claim_active',resolution_claim_token IS NOT NULL,'recovery_pending',resolution_recovery_pending) ORDER BY id) FROM issuance_service.evidence_policy_reviews),'resolved_events',(SELECT count(*) FROM issuance_service.issuance_events WHERE event_type='evidence_policy_review_resolved'))",
