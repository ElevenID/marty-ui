{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marty.elevenidllc.com/contracts/passport-digital-package-manifest/v1",
  "title": "Private Marty digital passport handoff manifest",
  "description": "Shape validation only. The verifier must also perform the cryptographic, tenant, source-job, MRZ, and independent-review checks in passport-digital-handoff-behavior.json. This manifest is encrypted and never a public acceptance artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_revision", "identity", "document", "custody", "lineage"],
  "properties": {
    "schema": {"const": "marty.passport-digital-package-manifest/v1"},
    "package_revision": {"type": "integer", "minimum": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "source_job_id", "application_id", "flow_execution_id", "credential_template_id", "application_template_id", "delivery_destination_profile_id", "artifact_seal_flow_attestation_sha256"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/identifier"},
        "source_job_id": {"$ref": "#/$defs/identifier"},
        "application_id": {"$ref": "#/$defs/identifier"},
        "flow_execution_id": {"$ref": "#/$defs/identifier"},
        "credential_template_id": {"$ref": "#/$defs/identifier"},
        "application_template_id": {"$ref": "#/$defs/identifier"},
        "delivery_destination_profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_seal_flow_attestation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "country_code", "mrz_sha256", "dg1_mrz_sha256", "data_group_sha256", "sod_data_group_sha256", "mrz_verification", "sod_der_sha256", "dsc_certificate_der_sha256", "csca_certificate_der_sha256"],
      "properties": {
        "document_type": {"const": "TD3"},
        "country_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "mrz_sha256": {"$ref": "#/$defs/sha256"},
        "dg1_mrz_sha256": {"$ref": "#/$defs/sha256"},
        "data_group_sha256": {"$ref": "#/$defs/digitalDataGroupHashes"},
        "sod_data_group_sha256": {"$ref": "#/$defs/digitalDataGroupHashes"},
        "mrz_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format_valid", "check_digits_valid", "dg1_consistent"],
          "properties": {
            "format_valid": {"const": true},
            "check_digits_valid": {"const": true},
            "dg1_consistent": {"const": true}
          }
        },
        "sod_der_sha256": {"$ref": "#/$defs/sha256"},
        "dsc_certificate_der_sha256": {"$ref": "#/$defs/sha256"},
        "csca_certificate_der_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["csca_issuer_profile", "dsc_issuer_profile", "source_encrypted_artifact_manifest_sha256", "handoff_encrypted_artifact_manifest_sha256"],
      "properties": {
        "csca_issuer_profile": {"$ref": "#/$defs/issuerProfile"},
        "dsc_issuer_profile": {"$ref": "#/$defs/issuerProfile"},
        "source_encrypted_artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "handoff_encrypted_artifact_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_source_commit", "signed_stack_manifest_sha256", "services_oci_digest", "created_at"],
      "properties": {
        "protected_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "signed_stack_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "services_oci_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digitalDataGroupHashes": {
      "type": "object",
      "minProperties": 2,
      "required": ["1", "2"],
      "propertyNames": {"pattern": "^([1-9]|1[0-6])$"},
      "patternProperties": {"^([1-9]|1[0-6])$": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "issuerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "registry_revision", "profile_record_sha256", "kms_key_reference_sha256", "public_key_spki_sha256", "certificate_sha256", "custody_receipt_sha256"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "registry_revision": {"type": "integer", "minimum": 1},
        "profile_record_sha256": {"$ref": "#/$defs/sha256"},
        "kms_key_reference_sha256": {"$ref": "#/$defs/sha256"},
        "public_key_spki_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "custody_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
