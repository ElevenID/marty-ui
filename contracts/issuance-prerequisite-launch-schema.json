{
  "additionalProperties": false,
  "type": "object",
  "description": "Public verification launch for this immutable issuance intent. Complete this request with the same holder key before redeeming the credential offer. Contains no verification evidence.",
  "required": [
    "contract",
    "intent_digest",
    "flow_instance_id",
    "request_uri",
    "qr_data",
    "expires_at_epoch_micros"
  ],
  "properties": {
    "contract": {
      "const": "marty.issuance-prerequisite-start-response/v1",
      "type": "string"
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "flow_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "request_uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^https://"
    },
    "qr_data": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^openid4vp://authorize"
    },
    "expires_at_epoch_micros": {
      "type": "integer"
    }
  }
}
