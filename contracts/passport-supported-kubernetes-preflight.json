{
  "schema": "marty.passport-supported-kubernetes-preflight-contract/v1",
  "status": "blocked",
  "owner": "supported-consumer",
  "resources": [
    "configmap/marty-config",
    "deployment/gateway",
    "deployment/flow",
    "deployment/issuance-native",
    "deployment/passport-callback-signer-supported",
    "deployment/passport-provider-ingress",
    "deployment/issuance",
    "service/gateway",
    "service/flow",
    "service/issuance-native",
    "service/passport-callback-signer-supported",
    "service/passport-provider-ingress",
    "service/issuance"
  ],
  "rust_selectors": [
    "PASSPORT_NATIVE_GATEWAY_ENABLED",
    "PASSPORT_NATIVE_FLOW_ENABLED",
    "PASSPORT_NATIVE_HTTP_ENABLED"
