{
  "schema_version": 1,
  "http_routes": [
    ["GET", "/v1/flows/capabilities"],
    ["POST", "/v1/flows/definitions"],
    ["GET", "/v1/flows/definitions"],
    ["GET", "/v1/flows/definitions/{flow_id}"],
    ["PATCH", "/v1/flows/definitions/{flow_id}"],
    ["POST", "/v1/flows/definitions/{flow_id}/validate"],
    ["POST", "/v1/flows/definitions/{flow_id}/test"],
    ["POST", "/v1/flows/definitions/{flow_id}/activate"],
    ["DELETE", "/v1/flows/definitions/{flow_id}"],
    ["POST", "/v1/flows/instances"],
    ["GET", "/v1/flows/instances"],
    ["GET", "/v1/flows/instances/{instance_id}"],
    ["GET", "/v1/flows/instances/{instance_id}/result"],
    ["POST", "/v1/flows/instances/{instance_id}/advance"],
    ["POST", "/v1/flows/instances/{instance_id}/cancel"],
    ["GET", "/v1/flows/instances/{instance_id}/artifacts"],
    ["GET", "/v1/flows/instances/{instance_id}/artifacts/{artifact_id}"],
    ["POST", "/v1/flows/instances/{instance_id}/generate-qr"],
    ["POST", "/v1/flows/verify"],
    ["GET", "/oid4vp/did.json"],
    ["POST", "/v1/flows/instances/{instance_id}/submit"],
    ["POST", "/v1/flows/instances/{instance_id}/submit/dc-api"],
    ["POST", "/v1/flows/siop"],
    ["POST", "/v1/flows/siop/submit"],
    ["POST", "/v1/flows/webhooks/application-approved"],
    ["GET", "/health/native-backend"]
  ],
  "grpc_methods": [
    "CreateFlowDefinition",
    "GetFlowDefinition",
    "ListFlowDefinitions",
    "ActivateFlowDefinition",
    "DeleteFlowDefinition",
    "StartFlowInstance",
    "GetFlowInstance",
    "ListFlowInstances",
    "AdvanceFlowInstance",
    "CancelFlowInstance",
    "GetFlowResult",
    "ListFlowArtifacts",
    "StartVerification",
    "ApplicationApproved",
    "StreamFlowUpdates",
    "HealthCheck"
  ],
  "flow_types": {
    "oid4vci_pre_authorized": {"category": "ISSUANCE", "required": ["credential_template_id"], "steps": ["create_offer", "token_exchange", "credential_request", "issue_credential"]},
    "oid4vci_authorization_code": {"category": "ISSUANCE", "required": ["credential_template_id"], "steps": ["create_offer", "authorization", "token_exchange", "credential_request", "issue_credential"]},
    "mdl_issuance": {"category": "ISSUANCE", "required": ["credential_template_id"], "steps": ["application_submit", "validate_evidence", "approval_decision", "issue_mdl", "deliver_credential"]},
    "oid4vp_presentation": {"category": "VERIFICATION", "required": ["presentation_policy_id"], "steps": ["create_request", "wallet_selection", "presentation_submission", "verify_presentation"]},
    "mdl_presentation": {"category": "VERIFICATION", "required": ["presentation_policy_id"], "steps": ["device_engagement", "session_establishment", "request_items", "response_items", "session_termination"]},
    "siopv2": {"category": "VERIFICATION", "required": ["presentation_policy_id"], "steps": ["create_request", "authentication_submission", "verify_id_token"]},
    "application_approval_issuance": {"category": "ISSUANCE", "required": ["application_template_id"], "steps": ["accept_application", "validate_evidence", "approval_decision", "issue_credential", "deliver_credential"]},
    "credential_renewal": {"category": "RENEWAL", "required": ["credential_template_id"], "steps": ["validate_existing", "create_offer", "token_exchange", "credential_request", "issue_renewed_credential", "revoke_old_credential"]},
    "credential_revocation": {"category": "REVOCATION", "required": ["credential_template_id"], "steps": ["validate_revocation_request", "update_status_list", "notify_holder"]},
    "physical_document_issuance": {"category": "ISSUANCE", "required": ["credential_template_id", "application_template_id", "delivery_destination_profile_id"], "steps": ["accept_application", "validate_evidence", "approval_decision", "generate_data_groups", "sign_sod", "submit_to_personalization", "track_production", "quality_verify", "activate_credential"]},
    "combined": {"category": "COMBINED", "required": ["credential_template_id", "presentation_policy_id"], "steps": ["accept_application", "approval_decision", "issue_credential", "create_request", "presentation_submission", "verify_presentation"]},
    "custom": {"category": null, "required": ["extension"], "steps": []}
  },
  "status_projection": {
    "created": "PENDING",
    "pending": "PENDING",
    "in_progress": "IN_PROGRESS",
    "awaiting_wallet": "AWAITING_WALLET",
    "awaiting_approval": "AWAITING_APPROVAL",
    "awaiting_evidence": "AWAITING_EVIDENCE",
    "completed": "COMPLETED",
    "failed": "FAILED",
    "cancelled": "CANCELLED",
    "expired": "EXPIRED"
  },
  "transition_cases": [
    {"current": "created", "target": "pending", "allowed": true, "terminal": false},
    {"current": "pending", "target": "in_progress", "allowed": true, "terminal": false},
    {"current": "in_progress", "target": "awaiting_wallet", "allowed": true, "terminal": false},
    {"current": "awaiting_wallet", "target": "in_progress", "allowed": true, "terminal": false},
    {"current": "in_progress", "target": "completed", "allowed": true, "terminal": true},
    {"current": "completed", "target": "in_progress", "allowed": false, "terminal": null},
    {"current": "failed", "target": "pending", "allowed": false, "terminal": null},
    {"current": "expired", "target": "expired", "allowed": true, "terminal": true}
  ],
  "private_context": {
    "prefix": "_marty_",
    "keys": ["issuer_profile_id", "issuer_key_id", "issuer_algorithm", "key_access_mode", "verification_method_id", "signing_service_id", "signing_key_reference", "key_reference", "kms_provider", "provider", "key_name", "key_version", "transit_mount", "pre_auth_code", "pre_authorized_code", "pre-authorized-code", "access_token", "refresh_token", "client_secret", "private_key", "private_key_jwk", "session_token", "api_key"]
  },
  "verification_finalization": {
    "allowed_expected_statuses": ["awaiting_wallet", "in_progress"],
    "nonce_digest_algorithm": "sha256",
    "atomic_writes": ["nonce_consumption", "terminal_instance", "callback_outbox"],
    "replay_result": "conflict",
    "expired_result": "conflict"
  },
  "application_offer_idempotency": {
    "logical_key_fields": ["organization_id", "application_flow_key_hash"],
    "event_identity": "event_id_sha256",
    "same_payload": "replay_existing_plan",
    "different_payload": "conflict"
  },
  "callback_outbox": {
    "event_type": "flow.verification_completed",
    "audience": "marty-auth-service",
    "default_retention_seconds": 900,
    "default_max_attempts": 10,
    "default_lease_seconds": 30,
    "default_poll_milliseconds": 1000,
    "retry_base_seconds": 1,
    "retry_cap_seconds": 60,
    "terminal_states": ["delivered", "dead_letter", "expired"],
    "success_range": [200, 299],
    "follow_redirects": false,
    "scrub_on_delivery": ["destination_url", "payload"],
    "scrub_on_expiry": ["destination_url", "payload"]
  }
}
