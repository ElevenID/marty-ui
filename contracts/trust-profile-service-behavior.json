  "registry_sync": {
    "protocol": "MARTY_TRUST_REGISTRY_SYNC_V1",
    "max_response_bytes": 2097152,
    "max_pages": 100,
    "https_only": true,
    "reject_credentials_ports_queries_fragments_redirects": true,
    "resolve_and_pin_destination": true,
    "reject_loopback_and_unapproved_private_addresses": true,
    "operator_ca_bundle": true,
    "scheduled_refresh_starts_at_eighty_percent_of_interval": true,
    "scheduled_profile_failures_are_isolated": true,
    "initial_and_delta_updates_are_atomic": true,
    "reject_sequence_rollback_unknown_removal_duplicate_entries_and_repeated_tokens": true,
    "revalidate_imported_certificates_at_decision_time": true
  },
  "issuer_did_key_resolution": {
    "resolve_when_did_has_no_pinned_verification_keys": true,
    "resolve_keyless_relationships_before_internal_decision": true,
    "pin_only_assertion_method_public_jwks": true,
    "canonicalize_pinned_jwk_kid_to_assertion_method_id": true,
    "preserve_explicitly_pinned_public_jwks": true,
    "persist_resolution_source_timestamp_and_sha256": true,
    "configured_internal_resolver_precedes_public_egress": true,
    "public_egress_disabled_by_default": true,
    "public_egress_requires_explicit_exact_host_allowlist": true,
    "reject_private_jwk_members": true,
    "reject_empty_ambiguous_or_foreign_controller_assertion_methods": true,
    "resolution_failure_prevents_issuer_creation": true
  },
  "security": {
    "tenant_membership_and_action_permissions": true,
    "internal_service_authentication": true,
    "private_custody_metadata_is_rejected_and_scrubbed": true,
    "issuer_identifier_is_unique_per_organization": true,
    "profile_delete_rejects_attached_issuers": true,
    "native_backend_absence_fails_closed": true
  },
