  "persistence_tables": [
    "trust_profiles",
    "trust_frameworks",
    "organization_trust_profiles",
    "trust_registry_entries",
    "issuer_entities",
    "trust_registry_sources",
    "trust_registry_issuers",
    "trust_profile_issuers"
  ],
  "migration_chain": [
    ["33f047612e9b", null],
    ["7d8b4b4ef634", "33f047612e9b"],
    ["registry_001", "7d8b4b4ef634"],
    ["marty_trust_seed_001", "registry_001"],
    ["marty_trust_seed_002", "marty_trust_seed_001"],
    ["marty_trust_seed_003", "marty_trust_seed_002"],
    ["marty_trust_seed_004", "marty_trust_seed_003"],
