    "relationship_status": ["TRUSTED", "DENIED", "UNDER_REVIEW"],
    "cascade_revocation_policy": ["AUTO_CASCADE", "MANUAL", "NOTIFY_ONLY"],
    "trust_anchor_type": ["CSCA", "DSC"],
    "registry_operation": ["ADD", "REMOVE"],
    "registry_source": ["ICAO_PKD", "AAMVA", "EUDI_LOTL", "MANUAL"]
  },
  "system_frameworks": {
    "ICAO": {"formats": ["MDOC"], "sync_mode": "PKD_DELTA"},
    "AAMVA": {"formats": ["MDOC"], "sync_mode": "MANUAL"},
    "EUDI": {"formats": ["MDOC", "SD_JWT_VC"], "sync_mode": "MANUAL"}
