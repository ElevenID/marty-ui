{
  "supported_formats": {
    "type": "array",
    "items": {
      "type": "string"
    },
    "description": "Canonical formats persisted on this template."
  },
  "selective_disclosure_fields": {
    "type": "array",
    "items": {
      "type": "string"
    }
  },
  "zk_predicate_claims": {
    "type": "array",
    "items": {
      "type": "string"
    }
  },
  "derived_attributes": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source_claim",
        "derivation_type",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_claim": {
          "type": "string"
        },
        "derivation_type": {
          "type": "string"
        },
        "parameters": {}
      }
    }
  },
  "display_style": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "background_color",
      "text_color"
    ],
    "properties": {
      "background_color": {
        "type": "string"
      },
      "text_color": {
        "type": "string"
      },
      "logo_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "background_image_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "icon": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "validity_rules": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "default_validity_days",
      "max_validity_days",
      "renewable",
      "renewal_window_days",
      "not_before_offset_seconds",
      "require_revalidation",
      "revalidation_interval_days",
      "ttl_seconds"
    ],
    "description": "Complete canonical native whole-day validity readback, including zero/false/null fields. Canonical days are authoritative. Compatibility seconds fields report stored days multiplied by 86400 and do not preserve original input precision. Input aliases, precedence and validation are described separately by runtime__credential_template_validity_input.",
    "properties": {
      "default_validity_days": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "max_validity_days": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "renewable": {
        "type": "boolean"
      },
      "renewal_window_days": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "not_before_offset_seconds": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "require_revalidation": {
        "type": "boolean"
      },
      "revalidation_interval_days": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "ttl_seconds": {
        "type": "integer",
        "minimum": -185542587187200,
        "maximum": 185542587100800,
        "description": "Compatibility readback computed as default_validity_days * 86400. This is not the ttl_seconds input constraint."
      },
      "reissue_within_seconds": {
        "type": "integer",
        "minimum": -185542587187200,
        "maximum": 185542587100800,
        "description": "Compatibility readback computed as renewal_window_days * 86400; omitted when zero."
      }
    }
  }
}
