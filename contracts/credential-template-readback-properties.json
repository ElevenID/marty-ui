  "validity_rules": {
    "type": "object",
    "additionalProperties": false,
    "description": "Native whole-day durations. Seconds aliases override day aliases and round up to at least one day, saturating at i32::MAX days. ttl_seconds must be positive; legacy maximum/renewal seconds aliases clamp nonpositive values to one day. Explicit day aliases retain signed i32 values (including zero). not_before_offset_seconds overrides not_before_offset without day rounding. Omitted/null input fields inherit existing values or create defaults. Responses contain canonical day fields and not_before_offset_seconds; seconds aliases are input conveniences, not second-precision storage.",
    "properties": {
      "default_validity_days": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -2147483648,
        "maximum": 2147483647
      },
