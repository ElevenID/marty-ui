{
  "schema": "marty.applicant-service-behavior/v1",
  "http_operations": [
    {"method":"GET","path":"/v1/me/applicant-profile"},
    {"method":"PATCH","path":"/v1/me/applicant-profile"},
    {"method":"POST","path":"/v1/me/applicant-profile/biometrics"},
    {"method":"GET","path":"/v1/me/applications"},
    {"method":"GET","path":"/v1/issued-credentials/mine"},
    {"method":"POST","path":"/v1/me/applications"},
    {"method":"GET","path":"/v1/me/applications/{application_id}"},
    {"method":"POST","path":"/v1/me/applications/{application_id}/evidence"},
    {"method":"GET","path":"/v1/me/applications/{application_id}/evidence"},
    {"method":"GET","path":"/v1/me/applications/{application_id}/evidence/{evidence_id}"},
    {"method":"GET","path":"/v1/me/applications/{application_id}/evidence/{evidence_id}/content"},
    {"method":"DELETE","path":"/v1/me/applications/{application_id}/evidence/{evidence_id}"},
    {"method":"POST","path":"/v1/me/applications/{application_id}/submit"},
    {"method":"POST","path":"/v1/me/applications/{application_id}/withdraw"},
    {"method":"POST","path":"/v1/me/applications/{application_id}/claim"},
    {"method":"GET","path":"/v1/organizations/{organization_id}/applicants"},
    {"method":"GET","path":"/v1/organizations/{organization_id}/applicants/{application_id}"},
    {"method":"GET","path":"/v1/organizations/{organization_id}/applicants/{application_id}/evidence"},
    {"method":"GET","path":"/v1/organizations/{organization_id}/applicants/{application_id}/evidence/{evidence_id}"},
    {"method":"GET","path":"/v1/organizations/{organization_id}/applicants/{application_id}/evidence/{evidence_id}/content"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/evidence/{evidence_id}/revoke"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/lock"},
    {"method":"GET","path":"/v1/organizations/{organization_id}/applicants/{application_id}/lock"},
    {"method":"DELETE","path":"/v1/organizations/{organization_id}/applicants/{application_id}/lock"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/approve"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/reject"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/request-information"},
    {"method":"GET","path":"/v1/organizations/{organization_id}/applicants/{application_id}/checks"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/checks/{check_id}/start"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/checks/{check_id}/complete"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/issue"},
    {"method":"POST","path":"/v1/organizations/{organization_id}/applicants/{application_id}/withdraw"}
  ],
  "lifecycle_statuses": ["DRAFT","SUBMITTED","UNDER_REVIEW","PENDING_INFORMATION","APPROVED","OFFERED","REJECTED","WITHDRAWN","CREDENTIALED","SUSPENDED"],
  "claim_states": ["NOT_READY","BLOCKED","OFFER_READY","CLAIMED","EXPIRED"],
  "evidence_statuses": ["ACTIVE","REVOKED","EXPIRED","DELETED"],
  "evidence_sources": ["APPLICANT_UPLOAD","VERIFIED_EXTERNAL_FACT","VERIFIED_EXTERNAL_API"],
  "evidence_upload_types": ["DOCUMENT_SCAN","BIOMETRIC","SELFIE","THIRD_PARTY_VERIFICATION"],
  "maximum_evidence_bytes": 10485760,
  "reviewer_lock_ttl_seconds": 300,
  "profile_upsert": {
    "identity_keys": ["organization_id+oidc_subject", "organization_id+email"],
    "email_changes_preserve_profile_id": true,
    "missing_names_preserve_existing_values": true,
    "vetting_data_patch_merges": true,
    "split_identity_failure": "conflict"
  },
  "capabilities": [
    "tenant-bound self-service applicant profiles",
    "application-template-derived applications and validation",
    "credential claim mapping",
    "evidence upload, download, expiry, deletion and reviewer revocation",
    "biometric enrollment metadata",
    "vetting check lifecycle and evidence references",
    "reviewer lock acquisition, refresh and release",
    "approve, reject, request-information and withdraw decisions",
    "idempotent flow-driven issuance attempts and offer reconciliation",
    "tenant-scoped application domain events",
    "legacy v0.3 JSON-store migration and lossless persistence"
  ],
  "removed_legacy_routes_remain_absent": true,
  "failure_behavior": "fail_closed"
}
