{
  "schema_version": 1,
  "public_route": {
    "method": "PUT",
    "path": "/v1/signing-keys/issuer-identities/certificate-csr",
    "authentication": "gateway-authenticated organization context",
    "request_fields": [
      "organization_id",
      "issuer_did",
      "key_purpose",
      "credential_format",
      "algorithm",
      "country",
      "organization",
      "common_name"
    ],
    "response_fields": ["csr_pem", "issuer_did", "subject"]
  },
  "supported_passport_purposes": ["csca", "x509_doc_signer"],
  "supported_algorithms": ["ES256", "ES384", "ES512"],
  "custody": {
    "key_reference_from_active_profile_only": true,
    "reject_unknown_request_fields": true,
    "compare_did_and_current_kms_public_keys": true,
    "sign_pkcs10_info_in_kms": true,
    "verify_signature_before_returning_csr": true,
    "private_key_export": false
  },
  "subject": {
    "required_components": ["C", "O", "CN"],
    "country_code": "two uppercase ASCII letters",
    "organization_and_common_name": "1-64 ASCII letters, digits, spaces, hyphen, period, or underscore; no leading or trailing space"
  }
}
