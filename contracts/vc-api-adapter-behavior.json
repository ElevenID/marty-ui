{
  "schema_version": 1,
  "serialization": [
    {
      "name": "jwt_string",
      "field": "verifiableCredential",
      "input": "header.payload.signature",
      "expected": "header.payload.signature",
      "error": null
    },
    {
      "name": "vc_jose_envelope",
      "field": "verifiableCredential",
      "input": {
        "@context": ["https://www.w3.org/ns/credentials/v2"],
        "type": ["EnvelopedVerifiableCredential"],
        "id": "data:application/vc%2Bjwt,header.payload.signature"
      },
      "expected": "header.payload.signature",
      "error": null
    },
    {
      "name": "vp_jose_envelope",
      "field": "verifiablePresentation",
      "input": {
        "@context": "https://www.w3.org/ns/credentials/v2",
        "type": "EnvelopedVerifiablePresentation",
        "id": "data:application/vp+jwt,header.payload.signature"
      },
      "expected": "header.payload.signature",
      "error": null
    },
    {
      "name": "data_integrity_document",
      "field": "verifiableCredential",
      "input": {
        "@context": ["https://www.w3.org/ns/credentials/v2"],
        "type": ["VerifiableCredential"],
        "proof": {"type": "DataIntegrityProof", "cryptosuite": "eddsa-rdfc-2022"}
      },
      "expected": {
        "@context": ["https://www.w3.org/ns/credentials/v2"],
        "type": ["VerifiableCredential"],
        "proof": {"type": "DataIntegrityProof", "cryptosuite": "eddsa-rdfc-2022"}
      },
      "error": null
    },
    {
      "name": "wrong_envelope_media_type",
      "field": "verifiableCredential",
      "input": {
        "@context": ["https://www.w3.org/ns/credentials/v2"],
        "type": ["EnvelopedVerifiableCredential"],
        "id": "data:application/ld+json,header.payload.signature"
      },
      "expected": null,
      "error": "unsupported_serialization"
    },
    {
      "name": "malformed_jws",
      "field": "verifiableCredential",
      "input": {
        "@context": ["https://www.w3.org/ns/credentials/v2"],
        "type": ["EnvelopedVerifiableCredential"],
        "id": "data:application/vc+jwt,not-a-jws"
      },
      "expected": null,
      "error": "invalid_envelope"
    },
    {
      "name": "ordinary_json_without_data_integrity",
      "field": "verifiableCredential",
      "input": {"proof": {"cryptosuite": "eddsa-rdfc-2022"}},
      "expected": null,
      "error": "unsupported_serialization"
    }
  ],
  "offers": [
