{
  "schema": "marty.issuance-issued-credential-adapters/v1",
  "source": {
    "repository": "ElevenID/marty-credentials",
    "path": "services/issuance/infrastructure/api/routes.py",
    "commit": "15af5232df376bb9596b5aed3703110bf890fce5"
  },
  "operations": [
    {"method":"GET","path":"/v1/issued-credentials","operation":"list_issued_credentials"},
    {"method":"GET","path":"/v1/issued-credentials/{credential_id}","operation":"get_issued_credential"},
    {"method":"POST","path":"/v1/issued-credentials/{credential_id}/revoke","operation":"revoke_issued_credential","action":"revoke"},
    {"method":"POST","path":"/v1/issued-credentials/{credential_id}/suspend","operation":"suspend_issued_credential","action":"suspend"},
    {"method":"POST","path":"/v1/issued-credentials/{credential_id}/reinstate","operation":"reinstate_issued_credential","action":"reinstate"}
  ],
  "authentication": {
    "header": "X-API-Key",
    "server_setting": "ISSUANCE_API_KEY",
    "order": ["authenticate","unscoped_lookup","tenant_check","project_or_transition"],
    "trusted_tenant_header": "X-Organization-ID",
    "cross_tenant_list": {"status_code":403,"detail":"Organization context does not match requested organization"},
    "cross_tenant_record": {"status_code":404,"detail":"Issued credential not found"}
  },
  "list": {
    "required_query": "organization_id",
    "optional_query": "status",
    "status_filter": "case-insensitive public status after expiry projection",
    "ordering": "repository order"
  },
  "projection": {
    "required_fields": ["id","organization_id","credential_id","credential_type","credential_format","flow_execution_id","credential_template_id","subject_id","issued_at","status","status_list_entries","created_at"],
    "nullable_or_defaulted_fields": ["application_id","revocation_profile_id","renewed_from_credential_id","renewed_to_credential_id","renewable","renewal_eligible_at","can_renew","subject_claims_hash","valid_from","valid_until","credential_hash","revoked_at","revocation_reason","issuer_did","revoked_by","updated_at"],
    "credential_formats": ["MDOC","VDS_NC","SD_JWT_VC","VC_JWT","JSON_LD"],
    "statuses": ["ACTIVE","SUSPENDED","REVOKED","EXPIRED"],
    "expiry_rule": "active credential expires only when expires_at is earlier than now",
    "subject_precedence": ["credential.subject_did","credential.applicant_id","transaction.subject_did","transaction.applicant_id","credential.id"],
    "issuer_precedence": ["credential.issuer_did","transaction.issuer_did_override"],
    "private_fields_excluded": ["credential_jwt","claims","comments","deliveries","access_token","pre_auth_code","signing_key_reference"]
  },
  "lifecycle_request": {
    "extra_fields": "forbidden",
    "reason": {"nullable":true,"max_unicode_scalars":2000},
    "comments": {"nullable":true,"max_unicode_scalars":4000,"blank_normalized_to_null":true},
    "actor_headers_in_precedence_order": ["X-Authenticated-User-ID","X-User-ID","X-API-Key-ID"],
    "actor_source": "gateway-sanitized trusted headers only"
  },
  "lifecycle_audit": {
    "storage": "issuance_service.issuance_events",
    "atomic_with_status_compare_and_set": true,
    "schema": "marty.credential-lifecycle-audit/v1",
    "event_types": ["credential_revoked","credential_suspended","credential_reinstated"],
    "comments_are_private": true
  },
  "side_effects": ["revocation-profile publication","credential status compare-and-set","durable lifecycle audit","Canvas lifecycle synchronization","in-process lifecycle event"],
  "errors": {
    "missing_organization_query": 422,
    "missing_or_invalid_api_key": 401,
    "missing_trusted_tenant": 403,
    "issued_credential_not_found": 404,
    "invalid_transition": 400,
    "invalid_request": 422,
    "dependency_unavailable": 503
  },
  "intentional_native_corrections": [
    "ISSUED-CREDENTIAL-001:add-vds-nc-to-public-schema",
    "ISSUED-CREDENTIAL-002:preserve-comments-as-private-durable-audit",
    "ISSUED-CREDENTIAL-003:sanitize-repository-failures"
  ],
  "tracked_follow_ups": [
    {"method":"POST","path":"/v1/credentials/issued/batch-revoke","status":"UI intent exists; absent from frozen backend and gateway surfaces"},
    {"method":"GET","path":"/v1/credentials/revocations","status":"UI intent exists; absent from frozen backend and gateway surfaces"}
  ]
}
