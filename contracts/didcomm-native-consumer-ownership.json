{
  "schema": "marty.didcomm-native-consumer-ownership/v1",
  "required_modes": ["anoncrypt", "authcrypt"],
  "downgrade_or_fallback": "forbidden",
  "owner_selector": {
    "name": "DIDCOMM_DELIVERY_OWNER",
    "native_value": "native",
    "legacy_default": "legacy"
  },
  "native_origin": {
    "name": "ISSUANCE_NATIVE_SERVICE_URL",
    "value": "http://issuance-native:8005"
  },
  "selected_compose_models": [
    "docker-compose.beta.yml",
    "docker-compose.selfhost.prod.yml",
    "docker-compose.profile.issuance-native.yml",
    "docker-compose.profile.conformance-native.yml"
  ],
  "kubernetes": {
    "selector": "K8S_ISSUANCE_NATIVE_ENABLED",
    "selected_value": "true",
    "legacy_source_unchanged_until_render": true
  },
  "legacy_direct_compatibility": {
    "routes": [
      "POST /v1/issuance/initiate",
      "POST /v1/issuance/didcomm/deliver"
    ],
    "behavior": "delegate-whole-request-before-python-repository-or-crypto",
    "forwarded_headers": ["x-api-key", "x-organization-id", "idempotency-key"],
    "all_other_headers": "discard",
    "native_unavailable": "503-without-legacy-fallback"
  },
  "deferred": ["DIDCOMM-KMS-001"],
  "production_deployment": "unchanged"
}
