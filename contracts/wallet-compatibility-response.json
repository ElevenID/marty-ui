  "required": [
    "name",
    "description",
    "credential_format",
    "issuance_protocol",
    "deep_link_pattern",
    "wallet_apps",
    "specifications",
    "supported_platforms",
    "applied_override_ids",
    "derived_from",
    "is_override",
    "override_precedence",
    "merge_strategy",
    "template_wallet_configs",
    "created_at",
    "updated_at"
