{
  "schema": "marty.canvas-worker-oauth-revocation-secrets-scenarios/v1",
  "base_scenario": "canvas-worker-oauth-revocation-scenarios.json",
  "scope": "Actual published standalone worker secret-resolution composition; foreign-prefix references remain rejected by schema, never seeded by disabling constraints",
  "additional_secrets": [
    [
      "worker-refresh-token",
      "org-review",
      "synthetic-worker-refresh-token"
    ],
    [
      "worker-unrelated-token",
      "org-other",
      "synthetic-unrelated-token"
    ]
  ],
  "cases": [
    {
      "name": "absent_reference",
      "status": 200,
      "body": {},
      "request_count": 0,
      "delay_bounds": [
        30,
        37
      ],
      "seed": [
        "UPDATE issuance_service.canvas_oauth_connections SET access_token_secret_ref=NULL"
      ]
    },
    {
      "name": "empty_secret_id",
      "status": 200,
      "body": {},
      "request_count": 0,
      "delay_bounds": [
        30,
        37
      ],
      "seed": [
        "UPDATE issuance_service.canvas_oauth_connections SET access_token_secret_ref='org_secret://org-review/'"
      ]
    },
    {
      "name": "nested_secret_id",
      "status": 200,
      "body": {},
      "request_count": 0,
      "delay_bounds": [
        30,
        37
      ],
      "seed": [
        "UPDATE issuance_service.canvas_oauth_connections SET access_token_secret_ref='org_secret://org-review/nested/token'"
      ]
    },
    {
      "name": "missing_secret",
      "status": 200,
      "body": {},
      "request_count": 0,
      "delay_bounds": [
        30,
        37
      ],
      "seed": [
        "UPDATE issuance_service.canvas_oauth_connections SET access_token_secret_ref='org_secret://org-review/missing-token'"
      ]
    },
    {
      "name": "disabled_secret",
      "status": 200,
      "body": {},
      "request_count": 0,
      "delay_bounds": [
        30,
        37
      ],
      "seed": [
        "UPDATE issuance_service.organization_integration_secrets SET enabled=false WHERE id='worker-rest-token'"
      ]
    },
    {
      "name": "other_tenant_secret_id",
      "status": 200,
      "body": {},
      "request_count": 0,
      "delay_bounds": [
        30,
        37
      ],
      "seed": [
        "UPDATE issuance_service.canvas_oauth_connections SET access_token_secret_ref='org_secret://org-review/worker-unrelated-token'"
      ]
    }
  ],
  "secret_state_sql": "SELECT jsonb_build_object('access_ref',c.access_token_secret_ref,'refresh_ref',c.refresh_token_secret_ref,'secrets',(SELECT jsonb_object_agg(s.id,jsonb_build_object('organization_id',s.organization_id,'enabled',s.enabled,'used',s.last_used_at IS NOT NULL)) FROM issuance_service.organization_integration_secrets s)) FROM issuance_service.canvas_oauth_connections c WHERE c.id='worker-rest-connection'"
}
