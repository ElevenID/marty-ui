      "unknown_repeated_or_malformed_parameters": "invalid_notification_request",
      "authentication": "valid access token bound to the notification identifier's issuance transaction",
      "persistence": {
        "notification_binding_committed_with_credential_response": true,
        "events_are_durable_and_auditable": true,
        "identical_retries_are_idempotent": true,
        "multiple_distinct_supported_events_per_notification_id": true
      },
      "success": {"status_code": 204, "body": null},
      "invalid_notification_id": {
        "status_code": 400,
        "body": {"error": "invalid_notification_id"}
      },
      "invalid_notification_request": {
        "status_code": 400,
        "body": {"error": "invalid_notification_request"}
      }
    }
