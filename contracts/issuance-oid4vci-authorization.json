  "source_corrections_to_preserve": [
    {
      "id": "OID4VCI-PAR-001:public-issuer-tenant-precedence",
      "behavior": "issuer_org wins over a legacy inline organization selector in both PAR and authorization."
    },
    {
      "id": "OID4VCI-REDIRECT-001:registered-query-preservation",
      "behavior": "Authorization success and error parameters append with ampersand when a registered redirect already has a query."
    },
    {
      "id": "OID4VCI-REVOKE-001:canonical-before-local",
      "behavior": "Canonical status-list publication and credential persistence precede transaction revocation, with retry reconciliation."
    },
    {
      "id": "OID4VCI-PAR-002:single-use-digest-capability",
      "behavior": "PAR capabilities are digest-keyed, bounded, atomically consumed, and never stored in plaintext as keys."
    }
  ],
  "intentional_native_corrections": [
    {
      "id": "OID4VCI-AUTH-002:validate-and-bind-bearer",
      "legacy": "Deferred credential and notification accept any Authorization value beginning with 'Bearer ', including an empty token; deferred lookup is not bound to the token or tenant.",
      "native": "Authenticate a non-empty access token before parsing or resource lookup and require the token's authorization session or issuance transaction to own the requested transaction/notification.",
      "preserved_capability": "Valid wallet access tokens retain deferred retrieval and notification acknowledgment.",
      "required_errors": {
        "missing_invalid_or_unbound_token": {
          "status_code": 401,
          "headers": {"WWW-Authenticate": "Bearer"},
          "body": {"error": "invalid_token", "error_description": "Client authentication failed"}
        }
      }
    },
    {
      "id": "OID4VCI-NOTIFY-001:validate-notification-request",
      "legacy": "Notification ignores the complete request body and returns 204 for malformed or arbitrary content after a prefix-only bearer check.",
      "native": "Validate the supported OID4VCI notification body, preserve supported notification events as durable/auditable effects, and reject malformed or unsupported requests without acknowledging them.",
      "preserved_capability": "Valid accepted/deleted/failure wallet notifications receive 204 after their effect is committed.",
      "required_errors": {
        "invalid_notification_id": {
          "status_code": 400,
          "body": {"error": "invalid_notification_id"}
        },
        "invalid_notification_request": {
          "status_code": 400,
          "body": {"error": "invalid_notification_request"}
        }
      }
    },
    {
      "id": "OID4VCI-MGMT-001:registered-client-tenant-binding",
      "legacy": "Client registration uses organization_id from the body and ignores a conflicting trusted X-Organization-ID header.",
      "native": "Require the gateway-authenticated tenant to match organization_id before any save, using the same management tenant guard as list and revoke.",
      "preserved_capability": "Authorized tenant administrators can still create, rotate, activate, and deactivate their wallet registrations.",
      "required_errors": {
        "missing_trusted_tenant": {
          "status_code": 403,
          "body": {"detail": "Trusted organization context is required"}
        },
        "tenant_mismatch": {
          "status_code": 403,
          "body": {"detail": "Organization context does not match requested organization"}
        }
      }
    },
    {
      "id": "OID4VCI-ERROR-001:structured-sanitized-internal-errors",
      "legacy": "Unhandled repository failures can escape as text/plain Internal Server Error while explicit PAR failures are already sanitized OAuth JSON.",
      "native": "Use one DRY structured and sanitized JSON error boundary per public-protocol or management surface without disclosing dependency causes.",
      "preserved_capability": "All existing explicit OAuth and management error codes/details remain exact unless another listed correction replaces them.",
      "required_errors": {
        "public_protocol_repository_failure": {
          "status_code": 503,
          "body": {
            "error": "temporarily_unavailable",
            "error_description": "OID4VCI service is temporarily unavailable"
          }
        },
        "management_repository_failure": {
          "status_code": 503,
          "body": {"detail": "OID4VCI management service is temporarily unavailable"}
        }
      }
    },
    {
      "id": "SECURITY-ACCESS-TOKEN-001:exact-1800-second-expiry",
      "legacy": "Access tokens can remain usable without a durable expiry bound when an older issuance transaction or authorization session has no access_token_expires_at value.",
      "native": "Persist the exact 1800-second token lifetime, require the database clock to report the token as live on every public-protocol and credential lookup, and give pre-migration tokens one bounded transition lifetime.",
      "preserved_capability": "A valid unexpired wallet access token continues to authorize credential issuance, deferred retrieval, and notification acknowledgment.",
      "required_errors": {
        "expired_token": {
          "status_code": 401,
          "headers": {"WWW-Authenticate": "Bearer"},
          "body": {"error": "invalid_token", "error_description": "Client authentication failed"}
        }
      }
    },
    {
      "id": "OID4VCI-REDIRECT-002:http-or-https-only-localhost",
      "legacy": "An exact ALLOWED_REDIRECT_URIS entry can bypass redirect scheme safety and permit a non-HTTPS, non-loopback redirect.",
      "native": "Validate redirect scheme safety before applying the exact registered redirect allowlist: require HTTPS except for HTTP loopback hosts localhost, 127.0.0.1, and ::1.",
      "preserved_capability": "Registered HTTPS callbacks and registered HTTP loopback callbacks continue to receive the authorization redirect with the frozen query-preservation behavior.",
      "required_errors": {
        "unsafe_redirect_uri": {
          "status_code": 400,
          "body": {"error": "invalid_request", "error_description": "redirect_uri must use HTTPS"}
        }
      }
    }
  ],
