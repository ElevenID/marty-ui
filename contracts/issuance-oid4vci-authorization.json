  "par": {
    "request_uri_prefix": "urn:ietf:params:oauth:request_uri:",
    "ttl_seconds": 90,
    "maximum_encoded_parameter_bytes": 16384,
    "encoded_shape_in_order": [
      "response_type",
      "client_id",
      "redirect_uri",
      "scope",
      "state",
      "code_challenge",
      "code_challenge_method",
      "issuer_state",
      "authorization_details",
      "organization_id"
    ],
    "nullable_fields_are_stored": true,
    "required_protocol_parameters_at_par_time": [],
    "storage": {
      "key_at_rest": "sha256-digest-only",
      "payload": "complete-parameter-object",
      "single_use": true,
      "atomic_consume": true,
      "expired_or_replayed": {
        "status_code": 400,
        "body": {
          "error": "invalid_request",
          "error_description": "request_uri is invalid or expired"
        }
      },
      "unavailable": {
        "status_code": 503,
        "body": {
          "error": "temporarily_unavailable",
          "error_description": "Authorization request storage is unavailable"
        },
        "cause_disclosed": false
      }
    },
    "authorization_override": "Each truthy stored PAR value overrides the corresponding inline value; a stored organization_id overrides both public issuer_org and legacy organization_id.",
    "consume_timing": "The request URI is consumed before required-field, registered-client, redirect-policy, and native-engine validation and remains consumed after any later error."
  },
  "authorization": {
    "native_engine_lifetime_seconds": 600,
    "persisted_session_lifetime": {
      "environment_variable": "ISSUANCE_AUTH_SESSION_TTL_MINUTES",
      "unit": "minutes",
      "default_minutes": 60,
      "default_seconds": 3600,
      "configuration_read_timing": "process-import",
      "legacy_composition": "The route asks the native engine for a 600-second session, then creates and persists a Python AuthorizationSession without copying the engine expiry. The entity therefore owns the effective configured lifetime."
    },
    "native_engine_inputs": [
      "response_type",
      "client_id",
      "redirect_uri",
      "state",
      "code_challenge",
      "code_challenge_method",
      "issuer_state",
      "authorization_details",
      "scope"
    ],
    "authorization_details_invalid_json": "project-null-to-native-engine",
    "registered_client": {
      "lookup_scope": ["organization_id", "client_id"],
      "inactive_error": {
        "status_code": 400,
        "body": {
          "error": "unauthorized_client",
          "error_description": "Client registration is inactive"
        }
      },
      "redirect_match": "exact-string-membership"
    },
    "unregistered_redirect_policy": {
      "configured_allowlist": "exact-string-membership",
      "default": "https-required-except-localhost-ipv4-ipv6"
    },
    "session_persistence": {
      "before_success_response": true,
      "fields": [
        "native-code",
        "client-id",
        "redirect-uri",
        "scope",
        "state",
        "issuer-state",
        "native-credential-configuration-ids",
        "organization-id",
        "code-challenge",
        "code-challenge-method"
      ]
    },
    "redirect": {
      "status_code": 307,
      "existing_query_preserved": true,
      "success_parameters_in_order": ["code", "iss", "state-when-present"],
      "error_parameters_in_order": [
        "error",
        "error_description",
        "state-when-present"
      ],
      "issuer_parameter": "{ISSUER_BASE_URL}/org/{organization_id}",
      "native_validation_error_without_redirect": "direct-json-400"
    }
  },
  "registered_client": {
    "request": {
      "organization_id": "trimmed-non-empty-string",
      "client_id": "trimmed-string-1-to-512-characters",
      "jwks": "non-empty-public-ES256-P256-key-set-with-unique-kids-and-no-private-material",
      "redirect_uris": "unique-absolute-https-without-fragments; localhost HTTP allowed",
      "active_default": true,
      "unknown_fields": "ignored-by-legacy-pydantic-model"
    },
    "persistence": {
      "upsert_key": ["organization_id", "client_id"],
      "rotation_preserves_created_at": true,
      "rotation_updates_updated_at": true,
      "read_after_write_required": true
    },
    "response_fields": [
      "organization_id",
      "client_id",
      "jwks",
      "redirect_uris",
      "token_endpoint_auth_method",
      "active",
      "created_at",
      "updated_at"
    ],
    "token_endpoint_auth_method": "private_key_jwt"
  },
  "deferred_credential": {
    "request_field": "transaction_id",
    "pending_statuses": ["pending", "authorized"],
    "pending_response": {
      "status_code": 202,
      "headers": {"Retry-After": "5"},
      "body": {"transaction_id": "request-transaction-id"}
    },
    "issued_response": {
      "status_code": 200,
      "body": {"credential": "stored-credential-jwt"}
    },
    "issued_without_credential": {
      "status_code": 400,
      "body": {
        "error": "invalid_transaction_id",
        "error_description": "Transaction is in issued state"
      }
    },
    "terminal_response": {
      "status_code": 400,
      "body": {
        "error": "invalid_transaction_id",
        "error_description_template": "Transaction is in {status} state"
      }
    }
  },
  "notification": {
    "legacy_success": {"status_code": 204, "body": null},
    "legacy_body_effect": "none",
    "legacy_persistence_effect": "none",
    "native_correction": {
      "specification": {
        "name": "OpenID for Verifiable Credential Issuance 1.0 Final",
        "published": "2025-09-16",
        "section": "11 Notification Endpoint",
        "url": "https://openid.net/specs/openid-4-verifiable-credential-issuance-1_0-final.html#name-notification-endpoint"
      },
      "request_content_type": "application/json",
      "fields": [
        {"name": "notification_id", "required": true, "type": "non-empty-string"},
