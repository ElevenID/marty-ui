    "required": [
      "id",
      "organization_id",
      "title",
      "body",
      "severity",
      "event_type",
      "read",
      "status",
      "priority",
      "data",
      "target",
      "ttl_seconds",
      "created_at"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
