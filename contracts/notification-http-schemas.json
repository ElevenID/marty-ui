        "type": [
          "string",
          "null"
        ]
      },
      "body": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "link": {
        "type": [
          "string",
          "null"
        ]
      },
      "collapse_key": {
        "type": [
          "string",
          "null"
        ]
      },
      "correlation_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "organization_id": {
        "type": "string"
      },
