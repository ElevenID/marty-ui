      "event_type": {
        "type": "string"
      },
      "data": {
        "type": "object"
      },
      "ttl_seconds": {
        "type": "integer",
        "minimum": 1
      },
      "target": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "organization_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "user_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "device_tokens": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "webhook_endpoints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "email_addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [],
            "description": "Embedded delivery target. Omitted organization/user fall back to request selectors; explicit organization must equal the request organization. Channels accept case-insensitive FCM, SSE, WEBHOOK, EMAIL or SMS; omitted/empty channels use event defaults. Service validation checks destination and TTL constraints."
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "organization_id"
    ],
    "description": "Actual native send DTO. Defaults: email notification type, info severity, normal priority, custom event and 86400-second TTL. Title/message override subject/body; a configured template can supply text. Protected credential material is rejected. Unknown root/target fields are rejected. Acceptance does not establish delivery.",
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "runtime__notification_response": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
