{
  "schema": "marty.issuance-universal-ownership/v1",
  "native_coverage": "contracts/issuance-native-coverage.json",
  "runtime_surface": "contracts/issuance-runtime-surface.json",
  "default_owner": "issuance-native",
  "retained_legacy_owner": "issuance",
  "retained_legacy_http": [
    {"method": "GET", "path": "/v1/issuance/organizations/{organization_id}/retention"},
    {"method": "POST", "path": "/v1/issuance/organizations/{organization_id}/retention/purge"},
    {"method": "POST", "path": "/v1/passport/applications"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/activate"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/generate-data-groups"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/generate-sod"},
    {"method": "GET", "path": "/v1/passport/applications/{application_id}/production-status"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/quality-verify"},
    {"method": "POST", "path": "/v1/passport/applications/{application_id}/submit-personalization"},
    {"method": "GET", "path": "/v1/passport/capabilities"},
    {"method": "POST", "path": "/v1/passport/webhooks/personalization"}
  ],
  "default_compositions": {
    "compose": "docker-compose.base.yml",
    "conformance": "scripts/conformance_stack.py",
    "envoy": "config/envoy/envoy.yaml",
    "kubernetes": "scripts/deploy-kubernetes.sh"
  },
  "direct_client_boundary": "gateway",
  "production_composition": "docker-compose.selfhost.prod.yml",
  "production_unchanged": true,
  "python_deletion_authorized": false,
  "deferred": ["DIDCOMM-KMS-001"]
}
