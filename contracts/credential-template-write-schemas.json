{
  "runtime__credential_template_public_parameter": {
    "description": "Public JSON derivation parameters. Private custody/credential field names are forbidden recursively, case-insensitively. The native owner additionally limits nesting depth to 48; JSON Schema recursion does not encode that depth bound.",
    "anyOf": [
      {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/runtime__credential_template_public_parameter"
        }
      },
      {
        "type": "object",
        "propertyNames": {
          "not": {
            "pattern": "^(?:[kK][eE][yY]_[rR][eE][fF][eE][rR][eE][nN][cC][eE]|[sS][iI][gG][nN][iI][nN][gG]_[sS][eE][rR][vV][iI][cC][eE]_[iI][dD]|[sS][iI][gG][nN][iI][nN][gG]_[kK][eE][yY]_[rR][eE][fF][eE][rR][eE][nN][cC][eE]|[iI][sS][sS][uU][eE][rR]_[pP][rR][oO][fF][iI][lL][eE]_[iI][dD]|[pP][rR][iI][vV][aA][tT][eE]_[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE][kK][eE][yY][jJ][wW][kK]|[aA][cC][cC][eE][sS][sS]_[tT][oO][kK][eE][nN]|[aA][uU][tT][hH]_[tT][oO][kK][eE][nN]|[aA][pP][iI]_[kK][eE][yY]|[cC][lL][iI][eE][nN][tT]_[sS][eE][cC][rR][eE][tT])$"
          }
        },
        "additionalProperties": {
          "$ref": "#/components/schemas/runtime__credential_template_public_parameter"
        }
      }
    ]
  },
  "runtime__credential_template_claim_input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "display_name": {
        "type": "string"
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "claim_type": {
        "type": "string",
        "description": "Case/whitespace normalized by the native owner; overrides type when both are present. Legacy number/float/decimal map to integer, text/str to string and bool to boolean.",
        "examples": [
          "string",
          "integer",
          "boolean",
          "date",
          "datetime",
          "object",
          "array",
          "image",
          "binary"
        ]
      },
      "type": {
        "type": "string",
        "description": "Public alias for claim_type."
      },
      "display": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        }
      },
      "required": {
        "type": "boolean",
        "default": true
      },
      "selectively_disclosable": {
        "type": "boolean",
        "default": true
      },
      "derivable": {
        "type": "boolean",
        "default": false
      },
      "derived_from": {
        "type": [
          "string",
          "null"
        ]
      },
      "pattern": {
        "type": [
          "string",
          "null"
        ]
      },
      "enum_values": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "min_value": {
        "type": [
          "number",
          "null"
        ]
      },
      "max_value": {
        "type": [
          "number",
          "null"
        ]
      },
      "namespace": {
        "type": [
          "string",
          "null"
        ]
      },
      "mdoc_namespace": {
        "type": [
          "string",
          "null"
        ]
      },
      "mdoc_element_identifier": {
        "type": [
          "string",
          "null"
        ]
      },
      "display_icon": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "anyOf": [
      {
        "required": [
          "display_name"
        ]
      },
      {
        "required": [
          "display"
        ],
        "properties": {
          "display": {
            "required": [
              "label"
            ]
          }
        }
      }
    ],
    "description": "Public claim aliases are translated by the gateway before native request deserialization. Claim names must be unique; derived_from must refer to another claim in the same request. Those cross-item checks remain native validation."
  },
  "runtime__credential_template_privacy_input": {
    "description": "Create defaults to selective_disclosure. Explicit mode overrides the two disclosure flags; without mode, disclosing all and preferring predicates together is invalid.",
    "anyOf": [
      {
        "type": "string",
        "examples": [
          "standard",
          "selective_disclosure",
          "zero_knowledge",
          "minimal"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_disclose_all": {
            "type": "boolean",
            "default": false
          },
          "prefer_predicates": {
            "type": "boolean",
            "default": false
          },
          "sd_alg": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[sS][hH][aA]-256$"
          }
        },
        "allOf": [
          {
            "if": {
              "not": {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "type": "string"
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "default_disclose_all",
                  "prefer_predicates"
                ],
                "properties": {
                  "default_disclose_all": {
                    "const": true
                  },
                  "prefer_predicates": {
                    "const": true
                  }
                }
              }
            }
          }
        ]
      }
    ]
  },
  "runtime__credential_template_derived_input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "source_claim",
      "derivation_type"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "source_claim": {
        "type": "string"
      },
      "derivation_type": {
        "type": "string"
      },
      "parameters": {
        "$ref": "#/components/schemas/runtime__credential_template_public_parameter",
        "default": {}
      }
    }
  },
  "runtime__credential_template_display_input": {
    "type": "object",
    "additionalProperties": false,
    "description": "Canonical supported display fields. Omitted colors use native defaults. Unknown legacy fields may be ignored by native deserialization; they are not part of the public contract.",
    "properties": {
      "background_color": {
        "type": "string",
        "default": "#1a1a2e"
      },
      "text_color": {
        "type": "string",
        "default": "#ffffff"
      },
      "logo_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "background_image_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "icon": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "runtime__credential_template_create_request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "organization_id",
      "name",
      "credential_type",
      "compliance_profile_id",
      "issuer_did",
      "claims"
    ],
    "properties": {
      "organization_id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "description": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 2000
      },
      "credential_type": {
        "type": "string",
        "pattern": "^(?:[A-Z][a-zA-Z0-9]+|[a-z][a-zA-Z0-9]*(?:\\.[a-zA-Z0-9]+)+)$"
      },
      "vct": {
        "type": [
          "string",
          "null"
        ]
      },
      "doctype": {
        "type": [
          "string",
          "null"
        ]
      },
      "claims": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/runtime__credential_template_claim_input"
        }
      },
      "privacy_posture": {
        "$ref": "#/components/schemas/runtime__credential_template_privacy_input"
      },
      "selective_disclosure_fields": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "zk_predicate_claims": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "supported_formats": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        },
        "default": [
          "SD_JWT_VC"
        ]
      },
      "application_template_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "compliance_profile_id": {
        "type": "string",
        "minLength": 1
      },
      "trust_profile_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "revocation_profile_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "validity_rules": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/runtime__credential_template_validity_input"
          },
          {
            "type": "null"
          }
        ]
      },
      "issuer_did": {
        "type": "string",
        "pattern": "^did:",
        "maxLength": 2048
      },
      "derived_attributes": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/runtime__credential_template_derived_input"
        }
      },
      "display_style": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/runtime__credential_template_display_input"
          },
          {
            "type": "null"
          }
        ]
      },
      "schema_uri": {
        "type": "null",
        "description": "No schema_uri persistence exists; non-null writes are rejected."
      },
      "credential_payload_format": {
        "type": [
          "string",
          "null"
        ]
      },
      "issuance_protocol": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "description": "Complete canonical public write fields, reconciled with the gateway and native owner. Claims are mandatory and nonempty. UTF-8 byte limits, trimmed nonempty values, unique/cross-referenced claims, format/protocol compatibility, absolute vct for SD-JWT, doctype requirements, active compliance/trust/issuer binding and tenant permissions are enforced at runtime. Structural schema validation alone does not authorize or prove template creation."
  },
  "runtime__credential_template_update_request": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 255
      },
      "description": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 2000
      },
      "claims": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/runtime__credential_template_claim_input"
        }
      },
      "privacy_posture": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/runtime__credential_template_privacy_input"
          },
          {
            "type": "null"
          }
        ]
      },
      "selective_disclosure_fields": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "zk_predicate_claims": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "derived_attributes": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/components/schemas/runtime__credential_template_derived_input"
        }
      },
      "display_style": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/runtime__credential_template_display_input"
          },
          {
            "type": "null"
          }
        ]
      },
      "validity_rules": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/runtime__credential_template_validity_input"
          },
          {
            "type": "null"
          }
        ]
      },
      "supported_formats": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "application_template_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "trust_profile_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "revocation_profile_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "issuer_did": {
        "type": [
          "string",
          "null"
        ]
      },
      "credential_payload_format": {
        "type": [
          "string",
          "null"
        ]
      },
      "issuance_protocol": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "description": "Draft-only patch fields. Omitted or null optional inputs are no-ops, not clearing instructions; claims is an exception: if present it must be a nonempty array (gateway rejects null). organization_id, credential_type, compliance_profile_id, vct and doctype are not mutable through this request. Existing stored state and native policy/issuer checks determine whether a structurally valid patch succeeds. An empty revocation_profile_id string is the native explicit clear operation; null is still a no-op. Empty supported_formats is decoded by PATCH; stored format/protocol constraints still apply."
  }
}
