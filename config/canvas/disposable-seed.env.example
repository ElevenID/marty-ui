# Copy to .env.canvas-disposable.local and set a disposable organization actor key.
# Do not use beta or production credentials here.
CANVAS_DISPOSABLE_PROJECT=marty-canvas-disposable-local
PUBLIC_DOMAIN=canvas-disposable.invalid
PUBLIC_API_URL=http://gateway:8000
MARTY_API_BASE_URL=http://gateway:8000
ISSUANCE_INTERNAL_API_BASE_URL=http://issuance:8005
CANVAS_API_BASE_URL=http://canvas-real:3000
CANVAS_BROWSER_BASE_URL=http://localhost:18088
CANVAS_CONNECTOR_BASE_URL=http://localhost:18088
CANVAS_LTI_EXPERIENCE_BASE_URL=http://localhost:5173
UI_BASE_URL=http://localhost:5173
KC_HOSTNAME_PORT=18180
OIDC_ISSUER_URL_EXTERNAL=http://localhost:18180/realms/11id
OIDC_REDIRECT_URI=http://localhost:5173/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
CANVAS_INTEROPERABILITY_BADGE_VCT=http://localhost:5173/credentials/canvas-interoperability-foundations-badge
CANVAS_REAL_CONTAINER_NAME=marty-canvas-disposable-local-canvas-real
SIGNING_KEYS_INTERNAL_BASE_URL=http://signing-keys:8017/internal/signing-keys
SIGNING_KEYS_HOLDER_PROOF_BASE_URL=http://signing-keys:8017/internal/signing-keys
MARTY_API_KEY=replace-with-disposable-org-actor-key
ISSUANCE_API_KEY=dev-issuance-api-key
SIGNING_KEYS_INTERNAL_API_KEY=dev-signing-keys-internal-api-key
CANVAS_CREDENTIALS_SHARED_SECRET=disposable-canvas-ags-secret
CANVAS_LEGACY_EVENT_INGEST_ENABLED=true
# The disposable fixture qualifies setup; the managed beta pilot records the full evidence journey.
CANVAS_OPEN_BADGE_SCENARIO_ENABLED=false
CANVAS_DEMO_APPLICATION_SEED_ENABLED=false
CANVAS_DEMO_EVIDENCE_EVENT_ENABLED=false
CANVAS_DEMO_WALLET_CLAIM_ENABLED=false
CANVAS_DEMO_MIRROR_PUBLISH_ENABLED=false
CANVAS_ALLOW_PRIVATE_BASE_URLS=true
CANVAS_ALLOW_HTTP_LOCALHOST_BASE_URLS=true
