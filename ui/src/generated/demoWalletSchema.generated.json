{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation",
    "vendor",
    "build",
    "deployment_mode",
    "classification",
    "protocols",
    "capabilities",
    "result",
    "tested_at"
  ],
  "properties": {
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "string",
      "minLength": 1
    },
    "image_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "apk_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "lane_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the exact retained Android evidence report file bytes, including its reportSha256 field."
    },
    "deployment_mode": {
      "enum": [
        "BROWSER",
        "SELF_HOSTED_BROWSER",
        "ANDROID_EMULATOR",
        "PHYSICAL_DEVICE",
        "INTERNAL_CONTROL"
      ]
    },
    "classification": {
      "enum": [
        "FIRST_PARTY",
        "INDEPENDENT",
        "INTERNAL_CONTROL"
      ]
    },
    "protocols": {
      "$ref": "#/$defs/stringList"
    },
    "capabilities": {
      "$ref": "#/$defs/stringList"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "tested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
