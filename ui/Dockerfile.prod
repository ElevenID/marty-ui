# Production Dockerfile for Marty UI (Vite/React SPA)
# Stage 1: Build
FROM oven/bun:1.3.14-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS builder

WORKDIR /app

# The root package has a postinstall hook, so its implementation must be in
# the build context before dependency installation begins.
COPY package.json bun.lock ./
COPY scripts/patch-prerenderer-ts-deepmerge.cjs ./scripts/patch-prerenderer-ts-deepmerge.cjs
RUN bun install --frozen-lockfile

COPY . .
RUN DISABLE_PRERENDER=1 bun run build

# Stage 2: Serve with nginx
FROM nginx:1.29.1-alpine@sha256:42a516af16b852e33b7682d5ef8acbd5d13fe08fecadc7ed98605ba5e3b26ab8

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy production nginx config
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Copy built app
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
